        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "Halvern Dam and its right abutment were damaged, triggering a major crisis response in the Assek Valley region.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Approximately 11,800 to 12,400 residents were evacuated from Brindlemark, Quennard, and other affected towns.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Dangerous conditions developed at Halvern Reservoir, prompting alert level escalation from Yellow to Orange.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Highway 6 was closed at Sorrel River and later restored; multiple services were disrupted in affected areas.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            },
            {
              "text": "Multiple response organizations deployed, including Sorrel Basin Water Authority, Provincial Dam Safety Office, engineering corps, and police.",
              "confidence": "confirmed",
