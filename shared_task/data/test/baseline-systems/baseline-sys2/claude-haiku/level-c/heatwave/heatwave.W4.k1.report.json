          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A heatwave affecting Verlow has caused deaths, injuries, infrastructure damage, and dangerous conditions in multiple locations including Hetton Rise and Camber Green.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Critical infrastructure including hospital services and power systems have been disrupted. The Marnest substation was destroyed and the Verlow Tramways operator caused additional damage.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Multiple emergency response organizations including Provincial Public Health Institute (PPHI), Grennet Power, and The network operator have deployed resources and issued warnings.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
