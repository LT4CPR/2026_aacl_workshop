          "bullets": [
            {
              "id": "1a.1",
              "text": "A tornado affected Ostley County, with the primary impact zone including Estenwick, Dray Corners, and Millrow district. Multiple fatalities and injuries were reported, infrastructure was destroyed, and approximately 240 people were displaced.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
