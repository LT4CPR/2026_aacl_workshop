      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A tornado struck Ostley County, affecting Estenwick, Dray Corners, and surrounding areas on May 19–20, 2026, resulting in deaths, injuries, destruction of infrastructure, and mass displacement.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
