      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "May 19, 3:36 PM: A tornado warning was issued for Estenwick, Dray Corners, and Ostley County.",
              "confidence": "confirmed",
              "tweet_ids": [
                3
              ]
            },
            {
              "id": "2a.2",
              "text": "May 19, 7:04 PM–7:17 PM: People began evacuating from towns including Estenwick and Dray Corners as the tornado developed.",
              "confidence": "confirmed",
              "tweet_ids": [
                17,
                18,
                20
              ]
            },
            {
              "id": "2a.3",
              "text": "May 19, 7:16 PM–7:47 PM: Damage was reported in Millrow district and major infrastructure destruction was documented, including destruction of Route 12 and a grain elevator.",
              "confidence": "confirmed",
              "tweet_ids": [
                19,
                24,
                25
              ]
            },
            {
              "id": "2a.4",
              "text": "May 19, 9:51 PM: Deaths were confirmed to have occurred in Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [
                49
              ]
            },
            {
              "id": "2a.5",
              "text": "May 19, 9:54 PM: Three fatalities were confirmed in Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [
                51
              ]
            },
            {
              "id": "2a.6",
              "text": "May 20, 2:27 PM: The death toll was updated to nine deaths across Ostley County.",
              "confidence": "confirmed",
              "tweet_ids": [
                79,
                84,
                86
              ]
            },
            {
              "id": "2a.7",
              "text": "May 20, 8:27 AM: 38 people were injured in Estenwick.",
              "confidence": "confirmed",
              "tweet_ids": [
                63
              ]
            },
            {
              "id": "2a.8",
              "text": "May 20, 8:32 AM: Estenwick General Hospital was confirmed to not have been damaged.",
              "confidence": "confirmed",
              "tweet_ids": [
                65
              ]
            },
            {
              "id": "2a.9",
              "text": "May 22, 1:38 PM–2:19 PM: Estenwick Consolidated School and the gymnasium were destroyed.",
              "confidence": "confirmed",
              "tweet_ids": [
                154,
                157,
                160
              ]
            },
            {
              "id": "2a.10",
              "text": "May 23, 12:20 PM: Route 12 and grain elevator were restored.",
              "confidence": "confirmed",
              "tweet_ids": [
                186
              ]
            }
          ]
        }
      ]
