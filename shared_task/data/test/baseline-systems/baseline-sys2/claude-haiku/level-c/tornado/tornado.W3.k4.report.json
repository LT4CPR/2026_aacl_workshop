              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "The event resulted in multiple fatalities, injuries, infrastructure destruction, and displacement of residents across affected areas.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Emergency response was activated with police deployment and assistance requests from county emergency management.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
