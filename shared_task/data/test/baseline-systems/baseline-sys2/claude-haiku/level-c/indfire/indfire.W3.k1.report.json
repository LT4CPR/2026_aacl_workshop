          "bullets": [
            {
              "id": "1a.1",
              "text": "An industrial fire at Kellet Point in the Osmery area triggered evacuations, road closures, and a significant emergency response involving deployment of multiple organizations including Fallon Coatings, PEPA (Provincial Environmental Protection Agency), and The Operator.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Approximately 2,300 residents were evacuated from Brayle and additional people from <PERSON> in connection with the fire incident.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Injuries were documented in affected areas; no deaths were reported in connection with the Kellet Point fire.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
