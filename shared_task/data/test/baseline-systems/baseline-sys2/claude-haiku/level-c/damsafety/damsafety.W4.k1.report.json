      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "Halvern Dam sustained damage to its structure and right abutment, triggering a crisis response in the Assek Valley region affecting multiple towns including <PERSON> and Quennard.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Approximately 11,800–12,400 residents were evacuated from affected areas as alert levels were raised from Yellow to Orange.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Dangerous conditions developed at Halvern Reservoir, necessitating coordinated emergency response from multiple agencies including Sorrel Basin Water Authority, Provincial Dam Safety Office, and Provincial Engineering Corps.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
      ]
    },
