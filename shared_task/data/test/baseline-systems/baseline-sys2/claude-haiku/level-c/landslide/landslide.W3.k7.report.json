      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A landslide at Ashfell damaged the lower road, prompting evacuations of approximately 60 households from Withel terraces and people from Cranmoor and surrounding areas.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Services at mining operations (Corvane mine) and transportation infrastructure were disrupted across multiple locations.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Recovery efforts included policy revisions by the mine operator, infrastructure restoration, and community support mobilization.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
