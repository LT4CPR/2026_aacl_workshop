          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "Halvern Dam and its right abutment have been damaged, triggering a major crisis response in the Assek Valley region.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Mandatory evacuations have been ordered for multiple towns including <PERSON> and surrounding areas, with approximately 11,800–12,400 residents evacuated.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Dangerous conditions have developed at Halvern Reservoir, with alert levels raised from Yellow to Orange.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.4",
              "text": "Multiple response agencies have been deployed, including the Provincial Dam Safety Office, Sorrel Basin Water Authority, and Provincial Engineering Corps.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.5",
              "text": "Injuries have been documented in affected towns; Highway 6 has been closed.",
