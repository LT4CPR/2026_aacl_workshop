          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "An industrial fire occurred at Kellet Point, resulting in mandatory evacuations of approximately 2,300 residents from Brayle and additional displacements from Osmery and Sunder Flats area.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Kellet Road and surrounding infrastructure in Kellet Point industrial estate were closed; services were disrupted and subsequently restored in Brayle.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "<PERSON> and Provincial Environmental Protection Agency (PEPA) deployed in response; Fallon Coatings warehouse was not involved in the incident.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.4",
              "text": "No deaths were reported in connection with the Kellet Point fire; injuries were documented; no contamination was recorded.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
