          "title": "Overview",
          "bullets": [
            {
              "text": "An Ashfell landslide damaged the lower road and disrupted services in several affected areas.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Warnings were issued and residents were evacuated from Withel terraces, <PERSON>, and the bench areas.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "The lower road was later reported restored, while assistance and community support were reported in affected areas.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "The operator revised its policy, and mining and oversight bodies held meetings during the response period.",
              "confidence": "confirmed",
