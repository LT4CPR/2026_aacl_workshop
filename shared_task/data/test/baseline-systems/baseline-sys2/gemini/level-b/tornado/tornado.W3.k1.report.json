          "title": "Overview",
          "bullets": [
            {
              "text": "A severe tornado event impacted Ostley County, including Estenwick, Dray Corners, and the Millrow district, resulting in multiple casualties and extensive damage.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Authorities confirmed nine fatalities in Ostley County, with three deaths in the Millrow district, alongside reports of injuries and unaccounted residents.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Significant infrastructure impacts include the destruction of Estenwick Consolidated School and Route 12 closures, prompting displacement and local response actions.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
      ]
