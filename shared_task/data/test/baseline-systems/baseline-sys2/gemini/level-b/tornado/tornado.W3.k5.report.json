      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A severe tornado event has impacted Ostley County, including Estenwick, Dray Corners, and Millrow district, prompting warnings and evacuations.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "The disaster resulted in 9 fatalities in Ostley County (including 3 in Millrow district) and 38 injuries in Estenwick, alongside missing individuals and approximately 240 displaced residents.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Severe infrastructure damage was reported, including the destruction of Estenwick Consolidated School, its gymnasium, Route 12, and a local grain elevator, though Estenwick General Hospital remained undamaged.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Emergency authorities including Estenwick Police, the County Coroner, and Ostley County Emergency Management are responding, requesting assistance, and issuing situational updates.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
