      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "The structural collapse of the east wing of <PERSON> on Cobbett Row in Nerridge resulted in confirmed fatalities and injuries.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Emergency responders, including Nerridge Fire Service and Provincial Urban Search and Rescue, conducted operations that successfully rescued individuals from the site.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "While local utility and public services were disrupted and hazardous conditions developed along Cobbett Row, the west wing remained standing, the tower crane did not fall, and subsequent restoration was achieved.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
      ]
