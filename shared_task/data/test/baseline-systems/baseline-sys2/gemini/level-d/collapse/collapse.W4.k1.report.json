      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A structural collapse occurred at Aldan House on Cobbett Row in Nerridge, resulting in the destruction of the building's east wing.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "The collapse resulted in confirmed fatalities and multiple injuries across the area.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Emergency services, including the Nerridge Fire Service, Provincial Urban Search and Rescue, and Nerridge Police, deployed to rescue occupants, secure the perimeter, and manage hazardous conditions.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Approximately 85 residents were displaced from Cobbett Row, with local services disrupted before restoration efforts commenced.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
    },
    {
