          "title": "Overview",
          "bullets": [
            {
              "text": "A landslide event (the Ashfell slide/bench failure) caused damage to infrastructure and disrupted services across Withel, <PERSON>, Ashfell bench, and <PERSON>.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Evacuations were conducted for approximately 60 households from Withel terraces as well as residents from Cranmoor and Ashfell bench, leading to documented displacement.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Operations at Corvane mine were disrupted and information was released concerning the tailings dam and pond, alongside a formal policy revision by Yelverton Minerals.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Restoration efforts successfully reopened the lower road and restored local services, accompanied by community support and relief assistance.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
