          "title": "Overview",
          "bullets": [
            {
              "text": "The Ashfell landslide and bench failure caused structural damage to the lower road and led to widespread warnings and evacuations across Withel terraces and <PERSON>.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Service disruptions affected Ashfell bench and Corvane mine, while approximately 60 households were displaced from Cranmoor.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Mine operator Yelverton Minerals held meetings with the mines inspectorate, revised operational policy, and completed the restoration of the lower road.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
      ]
