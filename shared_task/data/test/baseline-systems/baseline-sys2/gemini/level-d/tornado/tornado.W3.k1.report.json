            {
              "text": "A severe tornado event impacted Ostley County, causing significant destruction, casualties, and displacement across Estenwick, Dray Corners, Millrow district, and <PERSON>.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "At least 9 fatalities have occurred across Ostley County, including 3 confirmed deaths in Millrow district, alongside documented injuries and missing persons.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Critical infrastructure sustained severe impact, including the destruction of Route 12, a local grain elevator, and Estenwick Consolidated School, though Route 12 and the grain elevator were subsequently restored.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
