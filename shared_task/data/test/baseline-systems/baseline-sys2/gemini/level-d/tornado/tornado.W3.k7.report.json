      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A severe tornado impacted Ostley County, causing casualties, displacement, and severe structural damage across Estenwick, Dray Corners, and the Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Nine fatalities were confirmed across Ostley County, including three in the Millrow district, alongside 38 injuries in Estenwick and six missing residents.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Extensive destruction was sustained by Route 12, local grain elevators, and Estenwick Consolidated School, displacing about 240 residents and prompting emergency assistance requests.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
      ]
    },
