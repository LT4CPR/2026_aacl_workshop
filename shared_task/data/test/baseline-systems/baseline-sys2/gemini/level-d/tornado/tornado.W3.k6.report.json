              "tweet_ids": [
                53,
                54,
                57
              ],
              "id": "2a.4"
            },
            {
              "text": "Thirty-eight injuries in Estenwick and a cumulative nine fatalities in Ostley County were confirmed on May 20.",
              "confidence": "confirmed",
              "tweet_ids": [
                68,
                69,
                88,
                90
              ],
              "id": "2a.5"
            },
            {
              "text": "Six residents were reported missing in Millrow district and assistance was requested on May 21.",
              "confidence": "confirmed",
              "tweet_ids": [
                116,
                117
              ],
              "id": "2a.6"
            },
            {
              "text": "Estenwick Consolidated School and its gymnasium were destroyed on May 22.",
              "confidence": "confirmed",
              "tweet_ids": [
                146,
                150
              ],
              "id": "2a.7"
            },
            {
              "text": "On May 23, Route 12 and the grain elevator were restored, and approximately 240 people were confirmed displaced from Millrow district and Ostley County.",
              "confidence": "confirmed",
              "tweet_ids": [
                167,
                172
              ],
              "id": "2a.8"
            }
          ]
        }
