      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A severe tornado impacted Ostley County, resulting in casualties, severe infrastructure destruction, and widespread displacements across Estenwick, Dray Corners, and Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Nine fatalities were confirmed in Ostley County alongside 38 injuries in Estenwick and six residents missing in Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Critical infrastructure sustained severe impacts, including the destruction of Estenwick Consolidated School and Route 12, though Route 12 has since been restored.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "text": "On May 19, 2026, tornado warnings were issued for Estenwick, Dray Corners, and Ostley County starting at 15:38 UTC.",
