      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A severe tornado impacted Ostley County, causing significant casualties, structural destruction, and displacement across Estenwick, Dray Corners, and the Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Nine fatalities have been confirmed across Ostley County, including three in the Millrow district, alongside 38 injuries in Estenwick and six persons reported missing.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Critical infrastructure sustained heavy damage, including the complete destruction of Estenwick Consolidated School, a local gymnasium, and Route 12, though Estenwick General Hospital remained undamaged.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
      ]
    },
