      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A severe tornado struck Ostley County, impacting Estenwick, Dray Corners, and the Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "The event caused 9 fatalities across the county, 38 injuries in Estenwick, and left 6 people unaccounted for in Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Extensive structural destruction included Route 12, a grain elevator, and Estenwick Consolidated School, alongside widespread displacements and service closures.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Local emergency services deployed personnel, issued warnings, coordinated emergency meetings, and requested external assistance.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
    },
