  "sections": [
    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A tornado impacted Ostley County, causing widespread damage, casualties, and infrastructure destruction across Estenwick, Dray Corners, Millrow district, and <PERSON>.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Nine fatalities and 38 injuries have been confirmed across Ostley County, with six residents reported missing in Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Major structural impacts include the destruction of Estenwick Consolidated School and gymnasium, as well as damage to Route 12 and a local grain elevator that were subsequently restored.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Emergency response operations are active, including police deployments, displacement of approximately 240 residents, and coordination between provincial weather authorities and county emergency management.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
    },
