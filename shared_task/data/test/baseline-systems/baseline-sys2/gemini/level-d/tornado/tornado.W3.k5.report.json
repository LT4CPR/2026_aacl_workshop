      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A severe tornado struck Ostley County, impacting Estenwick, Dray Corners, and Millrow district with severe damage and dangerous conditions.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "A total of nine fatalities have been confirmed across Ostley County, including three in Millrow district, alongside 38 injuries in Estenwick and reports of missing persons.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Severe infrastructure destruction occurred, including the destruction of Estenwick Consolidated School, a gymnasium, and Route 12 along with a grain elevator, though Route 12 was later restored.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Evacuations were conducted in Estenwick and Dray Corners, and approximately 240 individuals have been displaced countywide.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
    },
