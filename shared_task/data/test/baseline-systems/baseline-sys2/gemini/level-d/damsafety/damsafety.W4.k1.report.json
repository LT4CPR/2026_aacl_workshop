    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "Structural damage was reported at Halvern Dam and its right abutment, prompting hazardous condition reports at Halvern Reservoir and a flood warning along the Sorrel River.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Authorities escalated the alert level from Yellow to Orange and ordered mandatory evacuations for <PERSON> and <PERSON>, displacing over 12,000 residents, alongside evacuations in Quennard.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Emergency services including police, the Provincial Engineering Corps, and the Provincial Dam Safety Office deployed to secure the site, while Highway 6 was temporarily closed and later reopened.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Officials confirmed the dam and auxiliary spillway did not suffer catastrophic failure, enabling phased returns to begin alongside relief transfers and agency policy adjustments.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "text": "On 9 September 2025, damage to Halvern Dam and its right abutment was detected, and informational updates were initiated by the Sorrel Basin Water Authority.",
              "confidence": "confirmed",
              "tweet_ids": [
                15,
                17,
                26
              ],
              "id": "2a.1"
            },
            {
              "text": "On 10 September 2025, the regional alert level was elevated from Yellow to Orange, mandatory evacuations commenced across <PERSON> and <PERSON>, police deployed, injuries were recorded, and Highway 6 was closed.",
              "confidence": "confirmed",
              "tweet_ids": [
                60,
                63,
                115,
                159,
                175
              ],
              "id": "2a.2"
            },
            {
              "text": "On 11 September 2025, the Provincial Engineering Corps deployed, and authorities confirmed that Halvern Dam and its auxiliary spillway did not suffer complete failure.",
              "confidence": "confirmed",
              "tweet_ids": [
                212,
                225,
                226
              ],
              "id": "2a.3"
            },
            {
