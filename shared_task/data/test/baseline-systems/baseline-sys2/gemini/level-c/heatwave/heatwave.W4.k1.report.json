        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A severe heatwave in Verlow led to multiple fatalities and injuries across the town.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Critical infrastructure was severely impacted, including service disruptions at Verlow General Hospital and the destruction of the Marnest substation.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "The Provincial Public Health Institute and Grennet Power deployed emergency responses, issued warnings, and revised policies as dangerous conditions affected Hetton Rise, Camber Green, and local tower blocks.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
      ]
