      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A severe heatwave in Verlow has resulted in confirmed fatalities, injuries, and population displacement.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Critical infrastructure has suffered significant impacts, including service disruption at Verlow General Hospital, the total destruction of the Marnest substation, and damage linked to Verlow Tramways.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Emergency response agencies, including the Provincial Public Health Institute and Grennet Power, have deployed personnel, issued public warnings, requested assistance, and provided aid to affected residents.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
      ]
    },
