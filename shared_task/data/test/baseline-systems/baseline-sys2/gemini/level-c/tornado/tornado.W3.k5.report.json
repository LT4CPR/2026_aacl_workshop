        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A destructive tornado struck Ostley County, impacting Estenwick, Dray Corners, <PERSON>, and the Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Nine fatalities were confirmed across Ostley County, including three in the Millrow district, along with 38 injuries in Estenwick.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Severe infrastructure destruction occurred, including the destruction of Estenwick Consolidated School, a local grain elevator, and sections of Route 12.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Emergency evacuations were executed in Estenwick and Dray Corners, and approximately 240 people were displaced across Ostley County and the Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
