      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A destructive tornado struck Ostley County, severely impacting Estenwick, Dray Corners, Millrow district, and surrounding areas.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "The event resulted in 9 confirmed fatalities across Ostley County and 38 injuries in Estenwick, alongside reports of missing persons in Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Severe infrastructure destruction occurred, including the destruction of Estenwick Consolidated School, a gymnasium, Route 12, and a local grain elevator, displacing approximately 240 residents.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Emergency services deployed to affected districts while authorities managed evacuations, road closures, and subsequent repairs to critical transport infrastructure.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
    },
