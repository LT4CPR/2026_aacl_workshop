    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A severe tornado struck Ostley County, impacting Estenwick, Dray Corners, <PERSON>, and the Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Casualties include 9 confirmed fatalities across Ostley County, 38 injuries in Estenwick, and 6 people reported missing in the Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Severe structural destruction occurred across the area, including the complete destruction of Estenwick Consolidated School, a local gymnasium, Route 12, and a grain elevator.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Approximately 240 people were displaced across the Millrow district and Ostley County following urgent evacuations.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            },
            {
              "text": "Emergency services deployed to impacted zones while emergency management agencies coordinated relief requests, meetings, and infrastructure restoration.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.5"
            }
          ]
        }
      ]
    },
