      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A destructive tornado struck Ostley County, impacting Estenwick, Dray Corners, and the Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "The event caused nine fatalities in Ostley County, including three in Millrow district, along with 38 injuries in Estenwick and six missing persons in Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Severe infrastructure damage occurred, including the destruction of Route 12, a grain elevator, and Estenwick Consolidated School and its gymnasium, though Route 12 and the elevator were subsequently restored.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Approximately 240 people were displaced, prompting police deployments, official coordination meetings, and multiple requests for external assistance.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
    },
