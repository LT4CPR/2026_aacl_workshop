      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A severe tornado struck Ostley County, impacting communities including Estenwick, Dray Corners, and the Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "The event resulted in 9 fatalities across Ostley County, 38 injuries in Estenwick, 6 missing residents in the Millrow district, and the displacement of approximately 240 people.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Major infrastructure damage and destruction were reported, including the loss of Estenwick Consolidated School, its gymnasium, Route 12, and a grain elevator, though Route 12 and the grain elevator have since been restored.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
      ]
    },
