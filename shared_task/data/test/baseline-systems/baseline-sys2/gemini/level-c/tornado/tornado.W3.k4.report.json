      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A severe tornado impacted Ostley County, causing significant casualties, widespread structural destruction, and displacement across Estenwick, Dray Corners, and Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "The disaster resulted in nine fatalities across Ostley County, 38 injuries in Estenwick, and six people reported missing in Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Major infrastructure impacts included the destruction of Estenwick Consolidated School, a gymnasium, Route 12, and a local grain elevator, though Route 12 and the grain elevator were subsequently restored.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Approximately 240 residents were displaced from Millrow district and Ostley County, prompting emergency deployments and requests for outside assistance.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
