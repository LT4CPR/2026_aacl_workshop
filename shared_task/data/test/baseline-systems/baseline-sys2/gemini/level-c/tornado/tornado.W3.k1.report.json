      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A severe tornado impacted Ostley County, causing extensive structural destruction, casualties, and displacement across Estenwick, Dray Corners, <PERSON>, and the Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Nine fatalities have been confirmed across Ostley County, including three in the Millrow district, while six residents remain unaccounted for.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Critical infrastructure sustained severe impact, including the destruction of Estenwick Consolidated School, a gymnasium, Route 12, and a local grain elevator, though Estenwick General Hospital remained undamaged.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Approximately 240 residents have been displaced from the Millrow district and Ostley County as emergency services deploy and officials request external assistance.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
    },
