  "sections": [
    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A severe tornado impacted Ostley County, specifically Estenwick, Dray Corners, and the Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "The disaster resulted in 9 fatalities in Ostley County (including 3 confirmed in Millrow district), 38 injuries in Estenwick, and 6 people missing in Millrow district.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Evacuations took place across Estenwick and Dray Corners, with approximately 240 individuals displaced across Millrow district and Ostley County.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Severe infrastructure damage occurred, including the destruction of Estenwick Consolidated School and its gymnasium, as well as Route 12 and a local grain elevator in Dray Corners, though Route 12 and the grain elevator were subsequently restored.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
    },
