      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A structural collapse occurred at Aldan House in Nerridge, destroying the building and its east wing while leaving the west wing intact.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "The incident resulted in confirmed fatalities, documented injuries, and the displacement of approximately 85 residents around Cobbett Row.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Emergency services including Provincial Urban Search and Rescue, Nerridge Fire Service, and local police deployed to conduct rescues and secure the affected area.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
      ]
    },
