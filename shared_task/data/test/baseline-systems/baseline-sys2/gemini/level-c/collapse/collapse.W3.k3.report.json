        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A structural collapse destroyed Aldan House and its east wing on Cobbett Row in Nerridge, while the west wing and an adjacent tower crane remained intact.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "The collapse resulted in confirmed fatalities and injuries, prompting emergency search and rescue operations by the Nerridge Fire Service and Provincial Urban Search and Rescue (PUSAR).",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Emergency services deployed to manage dangerous conditions and service disruptions along Cobbett Row and Imber Street, with relief provided and infrastructure subsequently restored.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
      ]
