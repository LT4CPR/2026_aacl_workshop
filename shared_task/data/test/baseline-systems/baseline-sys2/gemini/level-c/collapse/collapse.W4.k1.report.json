    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A major building collapse destroyed Aldan House and its east wing on Cobbett Row in Nerridge, resulting in documented fatalities and multiple injuries.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Emergency services including Nerridge Fire Service and Provincial Urban Search and Rescue deployed to the site, rescuing at least nine individuals.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Approximately 85 people were displaced from Cobbett Row as dangerous conditions developed and local services were shut down.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Subsequent recovery and stabilization efforts commenced, including restoration of the site crane and organization of local community support.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
    },
