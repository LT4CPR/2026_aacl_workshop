        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A structural collapse of the east wing destroyed Aldan House on Cobbett Row and Imber Street in Nerridge, resulting in multiple casualties, service disruptions, and dangerous local conditions.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Emergency response operations involving Provincial Urban Search and Rescue, Nerridge Fire Service, and police successfully extracted several individuals while approximately 85 residents were displaced from Cobbett Row.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            }
          ]
        }
      ]
    },
    {
