          "bullets": [
            {
              "text": "A major building collapse struck <PERSON> in Nerridge, destroying its east wing and resulting in confirmed fatalities and injuries.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Emergency services, including the Nerridge Fire Service, Nerridge Police, and Provincial Urban Search and Rescue (PUSAR), deployed to Cobbett Row and Imber Street to rescue victims and manage dangerous site conditions.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "The incident forced the displacement of approximately 85 residents, closed local public services, and prompted community assistance and infrastructure restoration operations.",
              "confidence": "confirmed",
              "tweet_ids": [],
