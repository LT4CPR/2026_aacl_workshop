          "title": "Overview",
          "bullets": [
            {
              "text": "The Ashfell slide and bench failure caused structural damage to the lower road and affected areas in <PERSON>, leading to landslide warnings across Withel terraces.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Widespread service disruptions affected Ashfell bench, Corvane mine, and the lower road, while roughly 60 households were evacuated from the terraces and displaced from Cranmoor.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "The lower road has since been restored, and Yelverton Minerals revised its operating policy following a meeting with the mines inspectorate.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
