        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "The Ashfell landslide triggered warnings, evacuations, and infrastructure damage across Withel terraces, Cranmoor, Ashfell bench, and <PERSON> starting on 14 March 2026.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Physical damage was confirmed on the lower road in <PERSON> as well as in <PERSON> and the terraces, alongside widespread service disruptions affecting the bench, Corvane mine, and the lower road.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Precautionary evacuations removed approximately 60 households from Withel terraces and <PERSON>, alongside residents from Ashfell bench, followed by the displacement of 60 households from Cranmoor.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Mine operator Yelverton Minerals met with the mines inspectorate, revised operational policies in conjunction with an independent panel, and restored the lower road.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
