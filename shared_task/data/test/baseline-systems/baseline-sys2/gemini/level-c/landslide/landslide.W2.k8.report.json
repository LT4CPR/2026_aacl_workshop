        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A landslide and bench failure caused structural damage to the lower road and led to multiple warnings, evacuations, and service disruptions.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Warnings were issued for Withel terraces and <PERSON>, prompting the evacuation of roughly 60 households from Withel terraces and further evacuations from Ashfell bench.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Displacement subsequently affected 60 households from Cranmoor following the landslide activity.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Services were disrupted across Ashfell bench, Corvane mine, and the lower road, though the lower road was subsequently restored.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            },
            {
              "text": "Yelverton Minerals and an independent panel revised operational policies following the incidents.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.5"
            }
          ]
        }
      ]
