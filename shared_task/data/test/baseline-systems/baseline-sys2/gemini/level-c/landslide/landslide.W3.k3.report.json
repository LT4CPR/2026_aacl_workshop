        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "A landslide and bench failure at Ashfell caused structural damage to the lower road and prompted warnings across Withel terraces and <PERSON>.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Precautionary and emergency evacuations displaced approximately 60 households from Withel terraces, alongside evacuations in Cranmoor and Ashfell bench.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Service disruptions impacted the Ashfell bench, the Corvane mine pit, and local roadways before repairs and service restorations were achieved.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Mine operator Yelverton Minerals revised operational policy, met with the mines inspectorate, and community relief and support initiatives were deployed to affected areas.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
