          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "An industrial fire at Kellet Point triggered extensive emergency response, road closures, and large-scale evacuations across Brayle and <PERSON>.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Evacuations displaced thousands of residents from Brayle and hundreds from Osmery, alongside road closures on Kellet Road and utility disruptions in the industrial estate.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Multiple injuries were documented in <PERSON>, though no fatalities have been reported.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Environmental assessments recorded no contamination in Merrin Canal, and Fallon Coatings' warehouse was confirmed to be uninvolved.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
