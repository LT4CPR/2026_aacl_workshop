      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "An industrial fire at Kellet Point prompted emergency response operations, road closures, and widespread evacuations across Brayle and <PERSON>.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "No fatalities have been reported, although injuries were confirmed in Osmery and property damage occurred in Brayle.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Environmental assessments found no contamination in Merrin Canal, and Fallon Coatings confirmed its warehouse was not involved in the fire.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Infrastructure services and road access along Kellet Road have been restored, accompanied by community support and relief assistance in affected areas.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
    },
