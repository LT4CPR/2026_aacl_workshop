        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "An industrial fire at Kellet Point triggered widespread emergency warnings, road closures, and large-scale evacuations across Brayle and <PERSON>.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "No fatalities occurred, but multiple injuries were confirmed in Osmery and property damage was reported in Brayle.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Environmental monitoring by the Provincial Environmental Protection Agency confirmed no contamination in Merrin Canal, and utility services were restored in Brayle.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
      ]
    },
