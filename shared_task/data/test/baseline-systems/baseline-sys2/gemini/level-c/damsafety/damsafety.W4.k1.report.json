        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "Damage was reported to Halvern Dam and its right abutment, prompting emergency responses and hazardous condition monitoring at Halvern Reservoir.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "Evacuations displaced thousands of residents across Brindlemark, Quennard, and <PERSON> as alert levels were elevated from Yellow to Orange.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Injuries were confirmed in <PERSON> and disruptions occurred along Highway 6 before services were restored and phased returns began.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            }
          ]
        }
      ]
