      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "text": "Dangerous conditions developed at Halvern Reservoir following damage to Halvern Dam and its right abutment, prompting emergency river warnings.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.1"
            },
            {
              "text": "The emergency alert level was raised from Yellow to Orange, and mandatory evacuations displaced over 12,000 residents across Brindlemark, Quennard, and <PERSON>.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.2"
            },
            {
              "text": "Injuries were confirmed in Brindlemark, local services were disrupted, and Highway 6 was temporarily closed at Sorrel River.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.3"
            },
            {
              "text": "Multi-agency emergency deployments stabilized the situation, confirming the dam did not breach, reopening Highway 6, and initiating a phased return for displaced residents.",
              "confidence": "confirmed",
              "tweet_ids": [],
              "id": "1a.4"
            }
          ]
        }
      ]
    },
