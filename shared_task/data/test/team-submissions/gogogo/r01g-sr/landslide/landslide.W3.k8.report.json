      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "The Ashfell Slide is a mining-region landslide with contested attribution that occurred in Dreth from March 14 to March 20, 2026.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "The crisis began on March 14, 2026, following initial reports of bench failure and road damage in the Withel terraces and Cranmoor areas.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "By March 19, 2026, evacuations had been completed from multiple locations including Withel terraces and Cranmoor, with displacement confirmed for approximately 60 households.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.4",
              "text": "The crisis concluded on March 20, 2026, with restoration of key infrastructure such as the lower road and service recovery in Dreth and the Pellan.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
