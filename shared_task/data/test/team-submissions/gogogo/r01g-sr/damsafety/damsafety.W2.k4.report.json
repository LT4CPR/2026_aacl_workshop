          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "At 16:07 on Sep 9, government sources reported that Halvern Dam and the right abutment were damaged.",
              "confidence": "confirmed",
              "tweet_ids": [
                8
              ]
            },
            {
              "id": "2a.2",
              "text": "At 16:13 on Sep 9, media confirmed the same damage to Halvern Dam and its right abutment.",
