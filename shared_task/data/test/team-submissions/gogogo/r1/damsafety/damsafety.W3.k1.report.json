          "bullets": [
            {
              "id": "1a.1",
              "text": "The Halvern Dam Safety Emergency occurred in Brindlemark, Assek Valley from September 9 to 14, 2025.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "The hazard was an averted dam failure that prompted emergency actions and evacuations.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Initial reports indicated structural damage to the Halvern Dam and its right abutment on September 9, 2025.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.4",
              "text": "The crisis led to a mandatory evacuation of approximately 11,800 residents from Brindlemark and Ferris Hollow by September 10, 2025.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
