          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A multi-site tornado outbreak affected Estenwick, Ostley County, and surrounding areas from May 19 to May 23, 2026.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "The crisis began with a series of tornado warnings issued across Estenwick, Dray Corners, and Ostley County on May 19, 2026.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "The outbreak resulted in significant damage to infrastructure including Route 12 and the grain elevator in Estenwick and surrounding districts.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.4",
              "text": "Evacuations were initiated in Estenwick and Dray Corners following tornado warnings, with multiple reports confirming displacement of residents.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
