  {
   "id": "1",
   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "Halvern Dam and its right abutment on the Sorrel River above Brindlemark in the Assek Valley were reported damaged on 9 September 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Dangerous conditions developed at Halvern Reservoir, the alert level was raised from Yellow to Orange and a mandatory evacuation of Brindlemark and Ferris Hollow moved roughly 11,800 and later 12,400 people.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries were confirmed in Brindlemark; no deaths were reported and the dam and auxiliary spillway did not fail.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Sorrel Basin Water Authority, Brindlemark Police, the provincial engineering corps and the Provincial Dam Safety Office deployed, a phased return began and the operator revised its policy after meeting with Assek Valley Emergency Management.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
