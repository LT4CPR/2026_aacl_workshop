     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "Halvern Dam and its right abutment on the Sorrel River above Brindlemark in the Assek Valley were reported damaged on 9 September 2025, triggering a dam safety emergency.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The alert level was raised from Yellow to Orange the following morning and a mandatory evacuation was ordered for Brindlemark and Ferris Hollow, later extended to Quennard.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Roughly 11,800 residents were evacuated from Brindlemark in the first phase, with the evacuated figure rising to 12,400 by the end of the window; no casualties were reported.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Brindlemark Police deployed to the evacuated town, Sorrel Basin Water Authority provided information on the dam, and assistance was provided to evacuees in Quennard.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
