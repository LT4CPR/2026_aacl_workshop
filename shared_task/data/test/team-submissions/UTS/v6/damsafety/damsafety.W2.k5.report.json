     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "Halvern Dam on the Sorrel River above Brindlemark in the Assek Valley was reported damaged on 9 September 2025, with damage to the dam and its right abutment.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The damage prompted a mandatory evacuation of Brindlemark and Ferris Hollow the following morning and the alert level was raised from Yellow to Orange.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Roughly 11,800 residents were moved out of Brindlemark, with no casualties reported within the window.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The dam operator provided information on the situation while evacuations continued at the end of the window.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
