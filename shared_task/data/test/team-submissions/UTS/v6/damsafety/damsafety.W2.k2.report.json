     "bullets": [
      {
       "id": "1a.1",
       "text": "Halvern Dam on the Sorrel River above Brindlemark in the Assek Valley was reported damaged on September 9, 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Damage to the dam structure and its right abutment prompted a mandatory evacuation of Brindlemark and Ferris Hollow and an alert level rise from Yellow to Orange on the following morning.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Roughly 11,800 residents were moved out of Brindlemark, with no casualties reported within the window.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Sorrel Basin Water Authority and the dam operator issued information on the dam's condition while the evacuation was under way.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
