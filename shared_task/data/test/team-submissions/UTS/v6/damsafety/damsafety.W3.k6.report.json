     "bullets": [
      {
       "id": "1a.1",
       "text": "Halvern Dam on the Sorrel River above Brindlemark in the Assek Valley was reported damaged on 9 September 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Damage to the dam and its right abutment prompted a mandatory evacuation of Brindlemark and Ferris Hollow the following morning, later extended to Quennard.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Roughly 11,800 residents were initially reported evacuated from Brindlemark, a figure that rose to 12,400 by the end of the window.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The Sorrel Basin Water Authority issued information on the dam, the alert level was raised from Yellow to Orange, and police deployed to Brindlemark.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
