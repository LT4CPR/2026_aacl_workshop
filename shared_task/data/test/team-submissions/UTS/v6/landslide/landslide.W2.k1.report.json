     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "The Ashfell Slide, a landslide in the mining district of Dreth, affected the Withel terraces, Cranmoor and the Ashfell bench from 14 March 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The slide damaged the lower road and caused damage in Dreth and the Pellan, while services in the Ashfell bench and operations at the Corvane mine were disrupted.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 60 households were evacuated from the Withel terraces, with Cranmoor and the Ashfell bench also evacuated and 60 households later displaced from Cranmoor.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Yelverton Minerals restored the lower road, met the mines inspectorate, and revised its policy with an independent panel as attribution of the slide remained contested.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
