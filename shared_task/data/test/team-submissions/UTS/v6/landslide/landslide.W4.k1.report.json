   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "The Ashfell Slide, a mining bench failure near Dreth, damaged the lower road on 14 March 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Damage extended into Dreth and the Pellan, and operations at the Corvane mine and on the lower road were disrupted.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 60 households were evacuated from the Withel terraces and Cranmoor, and 60 households were displaced from Cranmoor.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The lower road and services were restored, and Yelverton Minerals revised its policy after meetings with the mines inspectorate and an independent panel.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
