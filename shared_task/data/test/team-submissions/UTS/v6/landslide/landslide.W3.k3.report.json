     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "The Ashfell Slide affected the mining district of Dreth from 14 March 2026, damaging the lower road at Withel.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The slide began as a failure of the Ashfell bench at the Corvane mine and later caused damage in Dreth and the Pellan.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "No casualties were reported; about 60 households were evacuated from the Withel terraces and 60 households were displaced from Cranmoor.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The lower road and services in Dreth were restored, and Yelverton Minerals revised its policy with an independent panel and the mines inspectorate.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
