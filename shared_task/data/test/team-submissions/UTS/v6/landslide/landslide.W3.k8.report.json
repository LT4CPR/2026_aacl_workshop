     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "The Ashfell Slide, a bench failure in the mining region around Dreth, was reported from 14 March 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The failure damaged the lower road and disrupted service on the upper Ashfell bench and at the Corvane mine.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 60 households were evacuated from the Withel terraces and Cranmoor, with 60 households later recorded as displaced from Cranmoor.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Yelverton Minerals restored the lower road and revised company policy, and the independent panel and the mines inspectorate met in Dreth.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
