     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A landslide from the Ashfell bench affected the Withel terraces and Cranmoor in Dreth from March 14, 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The bench failure damaged the lower road, disrupted service at the Corvane mine and caused damage in Dreth and the Pellan.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 60 households were evacuated from the Withel terraces and 60 households moved away from Cranmoor, with no casualties reported.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Yelverton Minerals restored the lower road and revised its policy, while the mines inspectorate and an independent panel met over the failure.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
