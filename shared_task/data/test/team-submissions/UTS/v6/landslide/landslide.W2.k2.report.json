   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "The Ashfell Slide, a landslide in the mining district around Withel and Dreth, began with a bench failure on 14 March 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The slide damaged the lower road, disrupted service at Ashfell bench and Corvane mine, and caused damage in Dreth and the Pellan as the situation developed over five days.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "No fatalities or injuries were reported in the window; about 60 households were evacuated from Withel terraces and 60 households were displaced from Cranmoor.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The operator, Yelverton Minerals, revised its policy alongside an independent panel and restored the lower road by the end of the window, while attribution of the slide remained contested.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
