     "bullets": [
      {
       "id": "1a.1",
       "text": "The Ashfell Slide affected the mining district of Dreth from 14 March 2026, when a bench failure above Withel carried material onto the lower road.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Damage extended to Dreth and the Pellan, and disruption spread from the upper bench to the Corvane mine and the lower road.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 60 households were evacuated from Withel terraces and 60 households were displaced from Cranmoor, with no casualties reported in the window.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Warnings covered Withel terraces and Cranmoor, the lower road was restored, and Yelverton Minerals met the mines inspectorate as the operator revised its policy.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
