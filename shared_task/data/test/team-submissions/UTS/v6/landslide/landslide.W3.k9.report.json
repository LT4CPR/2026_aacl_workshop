     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "The Ashfell Slide, a landslide in the mining region around Dreth, was reported from 14 March 2026 and affected the Withel terraces, Cranmoor and the Ashfell upper bench.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The slide damaged the lower road and caused damage in Dreth and the Pellan, disrupting service at the Corvane mine and across the upper bench.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "No casualties were reported, while about 60 households were evacuated from the Withel terraces and 60 households were displaced from Cranmoor.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Information was provided about the Corvane tailings dam, Yelverton Minerals and an independent panel revised the operator's policy, and service was restored in Dreth and the Pellan.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
