       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 60 households were evacuated from the Withel terraces, with further evacuations at Cranmoor and the Ashfell bench and 60 households displaced from Cranmoor.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Yelverton Minerals revised its policy and met the mines inspectorate, information was provided about the Corvane tailings dam, and the lower road was restored.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
