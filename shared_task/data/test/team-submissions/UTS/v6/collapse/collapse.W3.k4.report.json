   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "Aldan House, a residential block on Cobbett Row in Nerridge, collapsed on 3 November 2025, destroying the building and its east wing.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The west wing did not collapse and the adjacent tower crane did not fall, but dangerous conditions persisted at Cobbett Row and services in Imber Street and Cobbett Row were closed.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "The collapse caused deaths and injuries, and people were rescued from the rubble by the Nerridge fire service and Provincial Urban Search and Rescue.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Provincial Urban Search and Rescue and Nerridge Police deployed, residents were displaced from Cobbett Row, and restoration of Aldan House and the tower crane was reported by the end of the window.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
