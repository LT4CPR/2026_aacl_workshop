     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "Aldan House, a residential block on Cobbett Row in Nerridge, collapsed on the morning of November 3, 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The collapse destroyed Aldan House and its east wing, while the west wing and an adjacent tower crane remained standing.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Deaths and injuries were confirmed, and rescue teams recovered people from the site over several days.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Provincial Urban Search and Rescue and Nerridge Police were deployed, with Nerridge Emergency Management issuing information on the collapsed wing.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
