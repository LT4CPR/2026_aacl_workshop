   "id": "1",
   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "Aldan House, a residential block on Cobbett Row in Nerridge, collapsed on 3 November 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The collapse destroyed the main building and its east wing, while the west wing remained standing and no adjacent structures were reported damaged.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries were confirmed on the first day and deaths attributed to the east wing collapse were confirmed later in the window, with about 85 people displaced from Cobbett Row.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Provincial Urban Search and Rescue and Nerridge Police deployed to the site, rescues were carried out, and a tower crane in Imber Street was restored as the response continued.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
