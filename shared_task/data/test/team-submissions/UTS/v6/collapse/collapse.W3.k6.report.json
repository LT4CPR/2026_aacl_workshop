   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "Aldan House, a residential building on Cobbett Row in Nerridge, collapsed on the morning of 3 November 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The collapse destroyed Aldan House and its east wing, while the west wing did not collapse and dangerous conditions persisted at Cobbett Row.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries were confirmed on the first day, rescue teams recovered people from the site over several days, and deaths were confirmed by the end of the window, with about 85 people displaced from Cobbett Row.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Provincial Urban Search and Rescue and Nerridge Police deployed, Nerridge Emergency Management issued information on the collapsed wing, and restoration of the site and a tower crane in Imber Street was reported.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
