  {
   "id": "1",
   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "Aldan House, a residential block on Cobbett Row in Nerridge, collapsed on 3 November 2025, destroying the building and its east wing.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The collapse was confined to Aldan House and its east wing; the west wing did not collapse, the site tower crane did not fall and no adjacent structures were damaged, although dangerous conditions persisted at Cobbett Row.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries were confirmed on the first morning, Nerridge fire service rescued 9 people and Provincial Urban Search and Rescue recovered further people over the following days; deaths were confirmed by the sixth day and about 85 people were displaced from Cobbett Row.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Provincial Urban Search and Rescue and Nerridge Police deployed, services in Imber Street and Cobbett Row were closed and later restored, community support was organized in Imber Street, and the Provincial Building Safety Board met on the collapse.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
