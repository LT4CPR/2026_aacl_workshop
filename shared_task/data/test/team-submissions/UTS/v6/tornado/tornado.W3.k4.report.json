   "id": "1",
   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A multi-site tornado outbreak struck Estenwick, Dray Corners and Ostley County from May 19, 2026, prompting warnings across the affected communities.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Damage extended from the Millrow district to Palfrey and the surrounding farm belt, with Route 12, the Dray Corners grain elevator and Estenwick Consolidated School destroyed.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Nine deaths were confirmed across the county, 38 people were injured, six residents were unaccounted for and about 240 people were displaced.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Estenwick Police deployed to the town and the Millrow district, evacuations were carried out, and Route 12 and the grain elevator were restored by May 23.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
