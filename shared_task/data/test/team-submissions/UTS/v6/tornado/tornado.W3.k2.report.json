   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A multi-site tornado outbreak struck Estenwick and Ostley County beginning on 19 May 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Tornadoes affected Estenwick, Dray Corners, Palfrey, the Millrow district and the surrounding farm belt, destroying Route 12, the grain elevator and Estenwick Consolidated School.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Nine deaths were recorded across Ostley County, 38 people were injured in Estenwick and about 240 people were displaced.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Estenwick Police deployed to the town and the Millrow district, Ostley County Emergency Management requested assistance, and the county coroner reported on the fatalities.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
