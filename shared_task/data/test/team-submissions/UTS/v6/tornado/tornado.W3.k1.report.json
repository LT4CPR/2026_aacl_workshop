   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A multi-site tornado outbreak struck Estenwick and surrounding communities in Ostley County from May 19, 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Tornadoes tracked across Estenwick, Dray Corners, Palfrey, Millrow district and the surrounding farm belt, destroying Route 12, the grain elevator and Estenwick Consolidated School.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Nine deaths were confirmed across Ostley County, with injuries in Estenwick, 6 residents unaccounted for and about 240 people displaced.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Estenwick Police and Ostley County Emergency Management led the response, with Route 12 and the grain elevator restored and the coroner reporting on the deaths.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
