     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A multi-site tornado outbreak struck Estenwick and Ostley County from May 19, 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Tornadoes tracked across Estenwick, Dray Corners, Palfrey and the Millrow district, destroying Estenwick Consolidated School, its gymnasium, Route 12 and a grain elevator.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Nine deaths were confirmed across Ostley County, 38 people were injured in Estenwick and about 240 people were displaced.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Estenwick Police deployed to the affected districts, assistance was requested for the Millrow district, and Route 12 was restored.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
