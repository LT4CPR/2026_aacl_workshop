   "id": "1",
   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A multi-site tornado outbreak struck Estenwick and Ostley County between 19 and 23 May 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Tornadoes affected Estenwick, Dray Corners, Palfrey and the surrounding farm belt, destroying school buildings and road and grain infrastructure.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Nine deaths were confirmed across the county, 38 people were injured and 6 residents were unaccounted for.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Police, county emergency management and the provincial weather service responded, and Route 12 and the grain elevator were restored.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
