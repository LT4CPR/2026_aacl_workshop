   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A multi-site tornado outbreak struck Estenwick and Ostley County from 19 May 2026, affecting Dray Corners, Palfrey and the Millrow district.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Warnings were issued and residents evacuated before tornadoes destroyed Route 12, the grain elevator and Estenwick Consolidated School.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Nine deaths were confirmed across Ostley County, 38 people were injured and six residents remained unaccounted for.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Estenwick Police deployed to the worst-hit districts, emergency management requested assistance, and Route 12 and the grain elevator were restored.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
