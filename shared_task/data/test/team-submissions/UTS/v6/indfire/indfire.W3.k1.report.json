   "id": "1",
   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A warehouse fire at the Kellet Point industrial estate in Osmery began on 2 December 2025, prompting warnings for Brayle and Sunder Flats.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Kellet Road was closed through the estate and Merrin Canal, and a mandatory evacuation moved about 2,300 residents out of Brayle while about 300 people were displaced from Osmery.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries were confirmed in Osmery, no deaths were reported, and no contamination was recorded in Merrin Canal.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Fallon Coatings and the Provincial Environmental Protection Agency deployed, and officials clarified that the Fallon Coatings warehouse was not involved.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
