   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A warehouse fire broke out at the Kellet Point industrial estate in Osmery on 2 December 2025, prompting warnings for Brayle and Sunder Flats and the closure of Kellet Road.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "A mandatory evacuation moved about 2,300 residents out of Brayle on the first day, with about 300 people displaced from Osmery as the evacuation widened.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries were confirmed in Osmery on the second day, and no deaths were reported in connection with the fire.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Fallon Coatings and the Provincial Environmental Protection Agency deployed, officials stated the Fallon Coatings warehouse was not involved, and no contamination was recorded in Merrin Canal.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
