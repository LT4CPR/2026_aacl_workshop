     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A warehouse fire broke out at the Kellet Point industrial estate in Osmery on 2 December 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Warnings were issued for Brayle and then Sunder Flats, and Kellet Road was closed through the industrial estate and at Merrin Canal.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "A mandatory evacuation of Brayle moved about 2,300 residents and people were later evacuated from Osmery, with no casualty figures issued by the end of the window.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The site operator, Fallon Coatings, deployed in response to the fire; no cause had been stated.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
