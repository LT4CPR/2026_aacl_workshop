     "bullets": [
      {
       "id": "1a.1",
       "text": "A warehouse fire broke out at the Kellet Point industrial estate in Osmery on 2 December 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The fire prompted the closure of Kellet Road through the industrial estate and Merrin Canal and warnings for the neighbouring communities of Brayle and Sunder Flats.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 2,300 residents were evacuated from Brayle under a mandatory order, and about 300 people were displaced from Osmery.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Fallon Coatings, the site operator, deployed to the incident, with guidance to nearby communities updated through the day.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
