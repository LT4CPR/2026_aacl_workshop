  {
   "id": "1",
   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "An industrial fire broke out at Kellet Point industrial estate in Osmery on 2 December 2025, with the site operator Fallon Coatings deploying within the first hour.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Warnings were issued for Brayle, Sunder Flats and later Merrin Canal, Kellet Road was closed through the estate and the canal, and a mandatory evacuation moved about 2,300 residents from Brayle with about 300 people displaced from Osmery.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries were confirmed in Osmery and no deaths were reported in connection with the fire.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The Provincial Environmental Protection Agency deployed on the second day, no contamination was recorded in Merrin Canal, services and Kellet Road were restored, and Fallon Coatings revised its policy by the end of the window.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
