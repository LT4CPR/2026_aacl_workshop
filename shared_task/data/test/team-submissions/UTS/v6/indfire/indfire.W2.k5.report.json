     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A warehouse fire broke out at the Kellet Point industrial estate near Osmery on 2 December 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Warnings were issued for Brayle and then Sunder Flats, Kellet Road was closed, and a mandatory evacuation of Brayle followed within hours.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 2,300 residents were evacuated from Brayle, with further evacuations and displacement reported from Osmery; no casualties were reported in the window.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The site operator Fallon Coatings deployed to the fire and authorities issued road closure information; the cause of the fire was not reported.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
