     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A warehouse fire broke out at the Kellet Point industrial estate in Osmery on 2 December 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Warnings were issued for Brayle and Sunder Flats, Kellet Road was closed through the estate and at Merrin Canal, and a mandatory evacuation of Brayle followed in the afternoon.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "No casualties were reported in the first ten hours; about 2,300 residents were reported evacuated from Brayle, with a later figure of 48, and about 300 people were displaced from Osmery.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Fallon Coatings, the site operator, deployed to the fire, and guidance to residents was revised repeatedly as the situation developed.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
