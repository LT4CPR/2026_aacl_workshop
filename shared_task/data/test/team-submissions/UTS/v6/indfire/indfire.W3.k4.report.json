   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A warehouse fire broke out at the Kellet Point industrial estate in Osmery on 2 December 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Warnings were issued for Brayle, Sunder Flats and Merrin Canal, and Kellet Road was closed through the estate and at the canal.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries were confirmed in Osmery with no deaths reported, about 2,300 residents were evacuated from Brayle and about 300 people were displaced from Osmery.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Fallon Coatings and the Provincial Environmental Protection Agency deployed, officials stated the Fallon Coatings warehouse was not involved, and no contamination was recorded in Merrin Canal.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
