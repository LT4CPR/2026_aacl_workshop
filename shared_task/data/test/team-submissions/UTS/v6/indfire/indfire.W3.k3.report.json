   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A warehouse fire broke out at the Kellet Point industrial estate in Osmery on 2 December 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Warnings were issued for Brayle, Sunder Flats and Merrin Canal, Kellet Road was closed and a mandatory evacuation of Brayle followed, with about 300 people displaced from Osmery.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries were confirmed in Osmery and no deaths were reported in connection with the fire.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Fallon Coatings and the Provincial Environmental Protection Agency deployed, no contamination was recorded in Merrin Canal, and service was restored in Brayle by the end of the window.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
