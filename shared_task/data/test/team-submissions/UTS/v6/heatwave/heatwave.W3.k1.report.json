     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A heatwave affected the town of Verlow from 22 June 2026, with the Provincial Public Health Institute issuing a warning on 23 June.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The heat placed the electricity network under strain, disrupting service at Verlow General Hospital and destroying the Marnest substation.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries were confirmed in the town and deaths were attributed to the heatwave during the warning period.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The institute and network operator Grennet Power deployed, dangerous conditions developed at Hetton Rise and Camber Green, and a meeting was held in the town as Grennet Power revised its policy.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
