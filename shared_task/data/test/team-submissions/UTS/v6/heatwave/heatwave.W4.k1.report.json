   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A heatwave struck the town of Verlow between 22 June and 1 July 2026, placing severe strain on the Grennet Power electricity network.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The Provincial Public Health Institute issued warnings on 23 and 28 June, while load shedding, the destruction of Marnest substation and disruption of hospital service compounded the heat.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries were confirmed and deaths were attributed to the heatwave, with statistical mortality later revised upward, and residents moved away from the town because of displacement.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "PPHI and Grennet Power deployed, assistance reached Hetton Rise and its tower blocks, and Grennet Power revised its policy after meetings were held in Verlow.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
