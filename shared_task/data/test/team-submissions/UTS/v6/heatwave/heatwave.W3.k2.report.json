   "id": "1",
   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A heatwave struck the town of Verlow between 22 June and 1 July 2026, placing the electricity network under strain.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The Provincial Public Health Institute and the network operator Grennet Power issued warnings as load-shedding disrupted Verlow General Hospital and the Marnest substation was destroyed.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries were confirmed in the town and the heatwave was confirmed to have caused deaths, with deaths attributed to the warning period.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "By the end of the window the institute and Grennet Power had deployed to Hetton Rise and Camber Green, assistance was provided in the tower blocks and Grennet Power revised its policy.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
  {
   "id": "2",
   "title": "Timeline",
   "subsections": [
    {
     "id": "2a",
     "title": "Chronological timeline",
     "bullets": [
      {
       "id": "2a.1",
       "text": "On 23 June the Provincial Public Health Institute deploys to Verlow, issues a heat warning and asks for assistance.",
       "confidence": "confirmed",
       "tweet_ids": [
        4,
        6,
        12,
        18
       ]
      },
      {
       "id": "2a.2",
       "text": "On 25 June Grennet Power issues a load-shedding warning and deploys; service at Verlow General Hospital is disrupted.",
       "confidence": "confirmed",
       "tweet_ids": [
        36,
        37,
        39,
        42
       ]
      },
      {
       "id": "2a.3",
       "text": "On 26 June the Marnest substation is destroyed and injuries are confirmed in the town.",
       "confidence": "confirmed",
       "tweet_ids": [
        59,
        61,
        63,
        65
       ]
      },
      {
       "id": "2a.4",
       "text": "On 27 June people move away from Verlow amid displacement, and officials confirm that the heatwave caused deaths.",
       "confidence": "confirmed",
       "tweet_ids": [
        84,
        88,
        90
       ]
      },
      {
       "id": "2a.5",
       "text": "On 28 June the institute issues a further warning as deaths are attributed to the warning period.",
       "confidence": "confirmed",
       "tweet_ids": [
        93,
        95,
        99,
        103
       ]
      },
      {
       "id": "2a.6",
       "text": "On 1 July dangerous conditions are reported at Hetton Rise and Camber Green, assistance is provided in the tower blocks, Verlow Tramways damage is reported and Grennet Power revises its policy.",
       "confidence": "confirmed",
       "tweet_ids": [
        135,
        136,
        139,
        142,
        147
       ]
      }
     ]
    }
   ]
