   "id": "1",
   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "On 9 September 2025, Halvern Dam and its right abutment were damaged above Brindlemark in the Assek Valley.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Dangerous conditions developed at Halvern Reservoir and the alert level was raised from Yellow to Orange, but the dam and its auxiliary spillway did not fail.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Roughly 11,800 and later 12,400 residents were evacuated from Brindlemark and Ferris Hollow, and injuries were confirmed in Brindlemark.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The Sorrel Basin Water Authority, a provincial engineering corps and the Provincial Dam Safety Office deployed, and a phased return began on 14 September.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
