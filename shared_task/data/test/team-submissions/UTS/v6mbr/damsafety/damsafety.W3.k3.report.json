     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "Halvern Dam at Brindlemark in the Assek Valley was reported damaged on September 9, 2025, opening a dam safety emergency.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Damage to the dam and its right abutment led authorities to raise the alert level from Yellow to Orange and order a mandatory evacuation of the settlements below it.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Roughly 11,800 and later 12,400 residents were moved out of Brindlemark, with further evacuations from Ferris Hollow and Quennard.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Brindlemark Police deployed to the town, assistance was provided in Quennard, and the Sorrel Basin Water Authority and the dam operator issued public information updates.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
