     "bullets": [
      {
       "id": "1a.1",
       "text": "Halvern Dam at Brindlemark in the Assek Valley was reported damaged on 9 September 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Damage to the dam and its right abutment prompted a raise of the alert level from Yellow to Orange.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "A mandatory evacuation moved roughly 11,800 and later 12,400 residents out of Brindlemark, with people also evacuated from Ferris Hollow and Quennard.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Brindlemark Police deployed to the town and the Sorrel Basin Water Authority provided public information during the emergency.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
