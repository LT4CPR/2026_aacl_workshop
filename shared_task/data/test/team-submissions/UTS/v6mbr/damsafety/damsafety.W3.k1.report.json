     "bullets": [
      {
       "id": "1a.1",
       "text": "Halvern Dam on the Sorrel River at Brindlemark, in the Assek Valley, was reported damaged on September 9, 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Damage to the dam and its right abutment led to the alert level being raised from Yellow to Orange the following day.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Human impact took the form of displacement, with 12,400 people evacuated from Brindlemark and further evacuations from Ferris Hollow and Quennard.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The Sorrel Basin Water Authority issued information on the dam, Brindlemark Police deployed to the town and assistance was provided in Quennard.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
