     "bullets": [
      {
       "id": "1a.1",
       "text": "Halvern Dam on the Sorrel River at Brindlemark in the Assek Valley was reported damaged on 9 September 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Damage extended to the dam's right abutment, and the alert level was raised from Yellow to Orange the following morning.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Roughly 11,800 residents were evacuated from Brindlemark and further residents were moved out of Ferris Hollow.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "A mandatory evacuation remained in force, with the Sorrel Basin Water Authority and the dam operator issuing information on the damage.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
