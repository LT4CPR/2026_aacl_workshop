     "bullets": [
      {
       "id": "1a.1",
       "text": "Aldan House, a residential building on Cobbett Row in Nerridge, collapsed on November 3, 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The collapse destroyed the building and its east wing, while the west wing and an adjacent tower crane remained standing.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "The collapse caused deaths and injuries, with people rescued from the site by the fire service and Provincial Urban Search and Rescue.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Search and rescue, police and emergency management operations continued through the window, with restoration reported at the site by its end.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
