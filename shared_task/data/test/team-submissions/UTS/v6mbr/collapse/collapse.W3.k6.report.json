     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "Aldan House on Cobbett Row in Nerridge collapsed on 3 November 2025, destroying the building and its east wing.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The east wing came down while the west wing remained standing, and dangerous conditions persisted at the site.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Deaths and injuries were confirmed, nine people were rescued by the fire service and further people were pulled from the rubble.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Provincial Urban Search and Rescue and Nerridge Police deployed, and Nerridge Emergency Management issued information on the collapsed wing.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
