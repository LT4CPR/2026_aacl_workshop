   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A residential building collapse destroyed Aldan House on Cobbett Row in Nerridge on November 3, 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The east wing of the block collapsed, while the west wing and the tower crane at the site remained standing.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries and deaths were confirmed, nine people were rescued by the fire service and further people were recovered by search teams.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Provincial Urban Search and Rescue and Nerridge Police deployed, and the Provincial Building Safety Board met on the collapse.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
