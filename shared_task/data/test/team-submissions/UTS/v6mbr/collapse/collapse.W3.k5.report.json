   "id": "1",
   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "Aldan House, a residential block on Cobbett Row in Nerridge, collapsed on the morning of 3 November 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The collapse destroyed the main building and its east wing, while the west wing and an adjacent tower crane remained standing and dangerous conditions persisted at the site.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries were confirmed on the first day, people were rescued from the rubble, deaths were confirmed by the sixth day and about 85 residents were displaced from Cobbett Row.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Provincial Urban Search and Rescue and Nerridge Police deployed to the site, a warning was issued for Cobbett Row, services in Imber Street and Cobbett Row were closed and assistance was provided to those affected.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
