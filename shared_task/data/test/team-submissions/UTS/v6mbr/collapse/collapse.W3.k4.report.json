     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A residential building collapse destroyed Aldan House and its east wing on Cobbett Row in Nerridge on November 3, 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The east wing collapsed while the west wing remained standing, and service at the block was disrupted.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "The collapse caused deaths and documented injuries, and search teams rescued people from the rubble.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Provincial Urban Search and Rescue and Nerridge Police deployed to Cobbett Row, and Aldan House and its tower crane were later reported restored.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
