     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A residential building collapse destroyed Aldan House on Cobbett Row in Nerridge on November 3, 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The east wing collapsed with the main block, while the west wing did not collapse and the adjacent tower crane did not fall.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "The collapse caused deaths and injuries, with 9 people rescued by the fire service and further rescues by urban search and rescue teams.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Provincial Urban Search and Rescue and Nerridge Police deployed to the site, and Nerridge Emergency Management issued information about the collapsed wing.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
