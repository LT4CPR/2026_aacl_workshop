     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A heatwave affected the town of Verlow and surrounding areas between 22 June and 1 July 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Sustained heat placed the local electricity network under strain, with the Marnest substation destroyed and dangerous conditions reported at Hetton Rise and Camber Green.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Deaths were attributed to the heatwave, injuries were confirmed in the town and residents moved away from Verlow.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The Provincial Public Health Institute and Grennet Power issued warnings and deployed, and assistance was provided in the Hetton Rise tower blocks.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
