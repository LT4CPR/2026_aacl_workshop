     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A severe heatwave affected the town of Verlow from 22 June to 1 July 2026, placing the local electricity network under sustained strain.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The Marnest substation was destroyed and load shedding followed, disrupting Verlow General Hospital and the tram network.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Injuries were confirmed in the town, and deaths were attributed to the heatwave and to the warning period.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The Provincial Public Health Institute and Grennet Power deployed, assistance was provided at Hetton Rise, and the network operator revised its policy.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
