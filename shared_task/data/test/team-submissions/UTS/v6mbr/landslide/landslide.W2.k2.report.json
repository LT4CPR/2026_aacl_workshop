     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "The Ashfell Slide affected the mining district around Withel in Dreth from 14 March 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "A failure of the Ashfell mining bench damaged the lower road, and further damage was recorded in Dreth and the Pellan.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 60 households were evacuated from the Withel terraces and Cranmoor, and 60 households were subsequently recorded as displaced from Cranmoor.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Warnings, evacuations and information on the Corvane tailings dam were followed by a policy revision by Yelverton Minerals and an independent panel and by restoration of the lower road on 19 March 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
