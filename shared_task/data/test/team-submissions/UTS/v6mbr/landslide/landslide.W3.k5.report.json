     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A landslide at the Ashfell bench above Dreth damaged the lower road from 14 March 2026, in a mining region where attribution for the failure was contested.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The bench failure spread damage across Dreth and the Pellan, disrupted service at the Corvane mine and on the lower road, and prompted warnings for the Withel terraces and Cranmoor.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 60 households were evacuated from the Withel terraces and 60 households were displaced from Cranmoor, with no casualties reported in the window.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Yelverton Minerals restored the lower road, met the mines inspectorate, and revised its policy alongside an independent panel.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
