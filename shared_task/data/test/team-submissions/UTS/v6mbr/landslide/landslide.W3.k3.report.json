     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "The Ashfell Slide, a mining-region landslide, affected Withel and the surrounding parts of Dreth from March 14, 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "A bench failure above the Withel terraces damaged the lower road and prompted successive evacuations of the terraces, Cranmoor and the upper Ashfell bench.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 60 households were evacuated from the Withel terraces and 60 households were displaced from Cranmoor, with no casualties reported.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The lower road and services in Dreth and the Pellan were restored, and Yelverton Minerals revised its policy with an independent panel and met the mines inspectorate.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
