     "bullets": [
      {
       "id": "1a.1",
       "text": "The Ashfell slide damaged the lower road at Dreth on 14 March 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Damage extended through Dreth and the Pellan, with service disrupted on the Ashfell upper bench, on the lower road and at the Corvane mine.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "No casualties were reported, while about 60 households left the Withel terraces and 60 households were displaced from Cranmoor.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Evacuations, community support and assistance were organized across the affected settlements, and Yelverton Minerals and an independent panel revised policy on the Corvane tailings dam.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
