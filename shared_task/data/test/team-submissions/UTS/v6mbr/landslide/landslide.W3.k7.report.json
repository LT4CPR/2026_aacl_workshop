     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "The Ashfell Slide, a mining-region landslide in the Dreth area, began on March 14, 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "A bench failure at Ashfell damaged the lower road, disrupted the Corvane mine and caused damage in Dreth and the Pellan.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 60 households were evacuated from the Withel terraces and Cranmoor, with households subsequently displaced from Cranmoor.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The lower road was restored, and Yelverton Minerals, the mines inspectorate and an independent panel met and revised the operator's policy.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
