     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "The Ashfell Slide was a landslide in the mining district around Dreth that began on March 14, 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Failure of the Ashfell bench damaged the lower road and prompted successive evacuations at the Withel terraces, Cranmoor and the bench itself.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 60 households were evacuated from the Withel terraces and Cranmoor, with 60 households displaced from Cranmoor.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Service at the Corvane mine was disrupted and the lower road was restored, while Yelverton Minerals, the independent panel and the mines inspectorate met and revised policy.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
