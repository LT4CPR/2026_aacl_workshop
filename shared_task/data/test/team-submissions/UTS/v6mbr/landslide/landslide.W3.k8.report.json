   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "On 14 March 2026 a bench failure in the Ashfell workings at Dreth set off the Ashfell Slide, damaging the lower road.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Damage extended to Dreth and the Pellan, and service at the Corvane mine and its pit was disrupted for several days.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 60 households were evacuated from Withel terraces, with residents also evacuated from Cranmoor and the Ashfell bench, and 60 households recorded as displaced from Cranmoor.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "The lower road and services in Dreth and the Pellan were restored, while Yelverton Minerals and an independent panel revised policy and the mines inspectorate met in Dreth.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
