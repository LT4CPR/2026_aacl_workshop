   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A multi-site tornado outbreak struck Estenwick and Ostley County beginning on 19 May 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Tornadoes tracked across Estenwick, the Millrow district, Dray Corners and Palfrey, destroying Route 12, a grain elevator and the consolidated school.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Nine deaths were confirmed across Ostley County, 38 people were injured and six residents remained unaccounted for.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Estenwick Police deployed to the affected districts and Ostley County Emergency Management requested outside assistance for Dray Corners.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
