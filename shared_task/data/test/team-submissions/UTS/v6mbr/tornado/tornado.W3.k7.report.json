   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A multi-site tornado outbreak struck Estenwick and surrounding communities in Ostley County from 19 May 2026, affecting Dray Corners, Palfrey and the Millrow district.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Tornado warnings were followed by destruction of Route 12, the Dray Corners grain elevator and Estenwick Consolidated School, including its gymnasium.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Nine deaths were reported across Ostley County, three of them in the Millrow district, alongside 38 injuries and 6 residents unaccounted for.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Estenwick Police deployed to the affected districts, about 240 people were displaced, and Ostley County Emergency Management requested further assistance.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
