   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A multi-site tornado outbreak struck Estenwick and Ostley County from 19 May 2026, with damage at Dray Corners, Palfrey and the Millrow district.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Tornadoes destroyed Route 12 and the Dray Corners grain elevator, and later Estenwick Consolidated School and its gymnasium.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "The confirmed death toll rose from 3 in the Millrow district to 9 across Ostley County, with 38 people injured and about 240 displaced.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Estenwick Police deployed to the affected districts and Ostley County Emergency Management requested assistance while dangerous conditions persisted.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
