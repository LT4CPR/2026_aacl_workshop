     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A multi-site tornado outbreak struck Estenwick and Ostley County beginning on May 19, 2026.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Tornadoes tracked across Estenwick, Dray Corners, Millrow district and Palfrey, destroying Route 12, the grain elevator and Estenwick Consolidated School.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "The death toll reached 9 across the county, with 38 people injured in Estenwick and 6 residents unaccounted for in Millrow district.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Estenwick Police and Ostley County Emergency Management led the response, with Route 12 and the grain elevator restored by the end of the window.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
