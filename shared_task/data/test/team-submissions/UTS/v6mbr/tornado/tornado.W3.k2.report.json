     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A multi-site tornado outbreak struck Estenwick and Ostley County from 19 May 2026, affecting Millrow district, Dray Corners and Palfrey.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The tornadoes destroyed Route 12 and the Dray Corners grain elevator, and destroyed Estenwick Consolidated School and its gymnasium.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Nine deaths were confirmed across the county, 38 people were injured and about 240 people were displaced.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Estenwick Police deployed to the affected districts, evacuations were carried out and Route 12 and the grain elevator were restored.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
