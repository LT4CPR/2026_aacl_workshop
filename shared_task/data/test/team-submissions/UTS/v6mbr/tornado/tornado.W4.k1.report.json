   "id": "1",
   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A multi-site tornado outbreak struck Estenwick and Ostley County from 19 May 2026, with warnings issued for Estenwick, Dray Corners and Ostley County.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Tornadoes tracked across the Millrow district of Estenwick, Dray Corners, Palfrey and the surrounding farm belt, destroying Route 12, the Dray Corners grain elevator and Estenwick Consolidated School with its gymnasium.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "Nine deaths were confirmed across Ostley County, 38 people were injured in Estenwick, six residents were unaccounted for in Millrow district and about 240 people were displaced.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Estenwick Police, Ostley County Emergency Management and the Provincial Severe Weather Centre led the response, with Route 12 and the grain elevator restored before the window closed.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
