     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A fire broke out at the Kellet Point industrial estate in Osmery on December 2, 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The fire at the Fallon Coatings site prompted warnings for the adjoining Brayle and Sunder Flats areas.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 2,300 residents were evacuated from Brayle and about 300 people were displaced from Osmery.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Fallon Coatings deployed at the site, Kellet Road was closed, and a mandatory evacuation of Brayle was under way.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
