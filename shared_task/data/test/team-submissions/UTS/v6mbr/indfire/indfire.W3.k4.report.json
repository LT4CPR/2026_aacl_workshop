     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A fire at the Kellet Point industrial estate in Osmery prompted an emergency response from December 2, 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Warnings and road closures spread from Brayle to Sunder Flats and the Merrin Canal as the response continued.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 2,300 residents were initially reported evacuated from Brayle, injuries were confirmed and no deaths were reported.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Fallon Coatings and the Provincial Environmental Protection Agency deployed, and reporting that the Fallon Coatings warehouse was involved was corrected.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
