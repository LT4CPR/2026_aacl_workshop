   "id": "1",
   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A fire broke out at a warehouse in the Kellet Point industrial estate at Osmery on 2 December 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "The fire prompted warnings for Brayle, Sunder Flats and Merrin Canal and the closure of Kellet Road through the estate and the canal.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "No deaths were reported, injuries were confirmed in Osmery, the Brayle evacuation figure settled at 48 residents after an initial count of about 2,300, and about 300 people were displaced from Osmery.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Fallon Coatings and the Provincial Environmental Protection Agency deployed, no contamination was recorded in Merrin Canal, and roads and services were restored by 5 December 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
