     "bullets": [
      {
       "id": "1a.1",
       "text": "A fire at the Kellet Point industrial estate in Osmery prompted an emergency response on December 2, 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Warnings were issued for Brayle and Sunder Flats, and Kellet Road was closed through the estate and at Merrin Canal.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "About 2,300 residents were evacuated from Brayle and about 300 people were displaced from Osmery, with no casualties reported.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Fallon Coatings deployed to the site and authorities issued updates on the road closure, with no cause reported for the fire.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
