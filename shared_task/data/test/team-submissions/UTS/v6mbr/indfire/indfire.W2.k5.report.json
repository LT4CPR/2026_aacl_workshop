     "bullets": [
      {
       "id": "1a.1",
       "text": "A fire at the Kellet Point industrial estate in Osmery developed through the day on 2 December 2025.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Warnings were issued for the adjacent areas of Brayle and Sunder Flats, and Kellet Road was closed through the estate and at the Merrin Canal.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "No casualties were reported, while about 2,300 residents were evacuated from Brayle, a figure later given as 48, and about 300 people were displaced from Osmery.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Fallon Coatings, the site operator, deployed, and evacuation figures and guidance were still being revised at the end of the window.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
