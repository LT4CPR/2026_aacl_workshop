     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A fire at the Kellet Point industrial estate in Osmery was reported on December 2, 2025, prompting warnings for neighbouring areas.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Warnings and road closures extended from the industrial estate to Brayle, Sunder Flats and Merrin Canal as the response developed.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "No deaths were reported, injuries were documented in Osmery, and about 2,300 residents were evacuated from Brayle.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Fallon Coatings and the Provincial Environmental Protection Agency deployed, and officials stated the Fallon Coatings warehouse was not involved.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
