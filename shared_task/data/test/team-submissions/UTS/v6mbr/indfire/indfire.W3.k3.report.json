   "title": "Situation overview",
   "subsections": [
    {
     "id": "1a",
     "title": "Overview",
     "bullets": [
      {
       "id": "1a.1",
       "text": "A fire at the Kellet Point industrial estate in Osmery began on 2 December 2025 and continued through the following days.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.2",
       "text": "Warnings were issued for Brayle, Sunder Flats and Merrin Canal, and Kellet Road was closed through the industrial estate and at Merrin Canal.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.3",
       "text": "A mandatory evacuation was ordered for Brayle, injuries were confirmed in Osmery and no deaths were reported.",
       "confidence": "confirmed",
       "tweet_ids": []
      },
      {
       "id": "1a.4",
       "text": "Fallon Coatings and the Provincial Environmental Protection Agency deployed, officials stated the Fallon Coatings warehouse was not involved, and no contamination was recorded in Merrin Canal.",
       "confidence": "confirmed",
       "tweet_ids": []
      }
     ]
    }
   ]
  },
