          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "An Estenwick tornado occurred, affecting multiple locations including the Millrow district and Ostley County.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Reports indicate three fatalities in the Millrow district and nine deaths in Ostley County, thirty-eight injuries, and six missing persons.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Dangerous conditions developed at Estenwick, Dray Corners, Palfrey, and the corners in Lorvane Plains.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.4",
              "text": "Response efforts include personnel deployment by Estenwick Police and the restoration of Route 12 and the grain elevator in Ostley County.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
