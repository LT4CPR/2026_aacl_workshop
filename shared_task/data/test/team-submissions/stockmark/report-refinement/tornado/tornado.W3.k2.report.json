      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "An incident caused damage and destruction across the farm belt, Palfrey, Millrow district, Estenwick, Dray Corners, and Ostley County.",
              "confidence": "unconfirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Reported human impact includes 9 fatalities in Ostley County and Dray Corners, 3 fatalities in Millrow district, 38 injuries in Estenwick, and approximately 240 displaced people from Millrow district and Ostley County.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Dangerous conditions were reported at Estenwick, Dray Corners, Palfrey, and the corners of the affected area.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.4",
              "text": "Response actions include the deployment of Estenwick Police to Estenwick and the Millrow district, and the restoration of the grain elevator and Route 12.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
