      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A tornado outbreak affected areas including Estenwick, Dray Corners, and Ostley County.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Three fatalities were reported in the Millrow district and nine deaths in Ostley County, thirty-eight people were injured in Estenwick, and approximately 240 people were displaced.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Dangerous conditions developed across Estenwick, Dray Corners, and Palfrey, resulting in the destruction of Route 12 and a grain elevator in Dray Corners and the Estenwick Consolidated School and gymnasium in Estenwick.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.4",
              "text": "Estenwick Police were deployed, residents were evacuated from Estenwick and Dray Corners, and Route 12 and the grain elevator were restored.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
