  "sections": [
    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "The Aldan House residential building on Cobbett Row, Nerridge, suffered a partial collapse destroying the main structure and east wing, resulting in fatalities, injuries, and displacement.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Provincial Urban Search and Rescue (PUSAR) and emergency services conducted rescue operations, provided medical treatment, and managed the scene amid dangerous conditions.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "By November 8, authorities confirmed deaths from the east wing collapse, documented injuries, displaced approximately 85 people from Cobbett Row, and began restoration efforts including tower crane repair.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "On November 3, 2025, at 06:57 UTC, reports emerged of Aldan House and east wing destruction; by 07:10 UTC, government confirmed the collapse and issued warnings for Cobbett Row; PUSAR deployed by 08:35 UTC; injuries were documented by 09:39 UTC; rescues occurred on November 4; by November 8, authorities confirmed deaths from the east wing collapse, noted dangerous conditions at Cobbett Row, reported 85 people displaced, and began restoration of the tower crane.",
              "confidence": "confirmed",
              "tweet_ids": [
                5,
                12,
                19,
                30,
                76,
                137,
                155,
                156,
                161
              ]
            }
