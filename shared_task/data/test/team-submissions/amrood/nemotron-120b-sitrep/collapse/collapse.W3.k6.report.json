      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "The Aldan House residential building collapse on Cobbett Row, Nerridge, destroyed the main structure and east wing, resulting in fatalities, injuries, and displacement.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Provincial Urban Search and Rescue (PUSAR) and emergency services conducted rescue operations, saving lives and providing medical care, while police maintained security and managed access.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "By November 8, displacement affected approximately 85 people from Cobbett Row, with restoration efforts underway for infrastructure like the tower crane in Imber Street, and dangerous conditions persisting at the site.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
