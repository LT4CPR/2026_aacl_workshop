          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "Aldan House and its east wing were destroyed in a residential building collapse on Cobbett Row, Nerridge, beginning November 3, 2025.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "The collapse caused deaths and injuries, prompting deployment of Provincial Urban Search and Rescue (PUSAR) and Nerridge Police for rescue operations and public safety.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Displacement occurred as about 85 people moved away from Cobbett Row, with services disrupted in Imber Street and Cobbett Row, and dangerous conditions reported at the site.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
