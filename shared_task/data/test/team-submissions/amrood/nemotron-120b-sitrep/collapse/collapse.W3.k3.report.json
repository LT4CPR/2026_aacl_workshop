      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "The east wing of Aldan House on Cobbett Row, Nerridge, collapsed on November 3, 2025, resulting in destruction of the building and east wing, with injuries documented and deaths later confirmed.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Provincial Urban Search and Rescue (PUSAR) deployed to conduct rescue operations, while emergency services provided assistance and managed dangerous conditions at the site.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "By November 8, 2025, authorities confirmed deaths from the east wing collapse, noted the west wing remained intact, and reported restoration of Aldan House and the tower crane, with police deployed and services closed in affected streets.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
