      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "Aldan House on Cobbett Row in Nerridge collapsed, destroying the building and its east wing, with the west wing remaining intact.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "The collapse resulted in fatalities and injuries, prompting deployment of Provincial Urban Search and Rescue (PUSAR) and Nerridge fire services, which rescued 9 people.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Nerridge Police and Emergency Management provided ongoing information, assistance was organized in Cobbett Row and Imber Street, and dangerous conditions persisted at the site.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
