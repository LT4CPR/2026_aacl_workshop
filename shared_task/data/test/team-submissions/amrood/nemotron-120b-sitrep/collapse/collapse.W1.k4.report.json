      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "Aldan House on Cobbett Row in Nerridge collapsed, destroying the building and its east wing. Provincial Urban Search and Rescue (PUSAR) deployed to the site, and Nerridge fire service rescued 9 people. Injuries were documented in Nerridge and the city, with warnings issued for Cobbett Row and service disruptions reported at Aldan House.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
