      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide (Ashfell Slide) occurred near Dreth, damaging the lower road and disrupting mine services. Warnings were issued for Withel terraces and Cranmoor, leading to the evacuation of about 60 households from Withel terraces and displacement from Cranmoor. Restoration efforts have restored the lower road, while service disruptions at the mine and tailings facilities persist.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
