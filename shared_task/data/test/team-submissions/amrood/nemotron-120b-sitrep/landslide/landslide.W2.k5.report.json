    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide (Ashfell Slide) damaged the lower road in Dreth and prompted evacuations from Withel terraces and Cranmoor, affecting approximately 60 households. Warnings were issued for Withel terraces and Cranmoor, and service disruptions occurred at the mine, pit, and lower road. Restoration efforts restored the lower road by March 19, while policy revisions were announced by Yelverton Minerals and the independent panel.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "On March 14, a warning was issued for Withel terraces and Cranmoor, followed by the evacuation of about 60 households from Withel terraces; the lower road was damaged by the Ashfell slide.",
              "confidence": "confirmed",
              "tweet_ids": [
                2,
                5,
                10
              ]
            },
            {
              "id": "2a.2",
              "text": "On March 16, service was disrupted in the Ashfell bench and people were evacuated from the bench as part of ongoing evacuation efforts.",
              "confidence": "confirmed",
              "tweet_ids": [
                45,
                46,
                48
              ]
            },
            {
              "id": "2a.3",
              "text": "On March 17, damage occurred in Dreth and the Pellan, and service was disrupted at the mine, pit, and Corvane mine.",
              "confidence": "confirmed",
              "tweet_ids": [
                60,
                61,
                71
              ]
            },
            {
              "id": "2a.4",
              "text": "On March 19, 60 households were displaced from Cranmoor, the lower road was restored, and Yelverton Minerals and the independent panel revised its policy.",
              "confidence": "confirmed",
              "tweet_ids": [
                105,
                115,
                124
              ]
            }
          ]
        }
      ]
