    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide (Ashfell Slide) occurred in Dreth, damaging the lower road and disrupting mine services. Evacuations affected approximately 60 households from Withel terraces and Cranmoor, with service disruptions reported at the Corvane mine, upper bench, and lower road. Restoration efforts began on March 19, including road and service repairs, alongside policy revisions by Yelverton Minerals and community support initiatives.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "On March 14, a bench failure damaged the lower road and warnings were issued for Withel terraces and Cranmoor; approximately 60 households were evacuated from Withel terraces and people from Cranmoor. On March 16, service disruptions occurred in the Ashfell bench (upper and lower). On March 17, damage was reported in Dreth and the Pellan, and service at Corvane mine was disrupted. On March 19, the lower road was restored, service was restored in Dreth and the Pellan, and Yelverton Minerals and the independent panel revised its policy.",
