    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide in Dreth damaged the lower road and disrupted services at the Corvane mine and Ashfell bench. Evacuations affected approximately 60 households from Withel terraces and Cranmoor, with displacement reported from Cranmoor. Warnings were issued for Withel terraces and Cranmoor, and operational responses included policy revisions by Yelverton Minerals and service restoration on the lower road.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "On 2026-03-14, warnings were issued for Withel terraces and Cranmoor, followed by the evacuation of about 60 households from Withel terraces and people from Cranmoor; the lower road was damaged by the bench failure. On 2026-03-16, service disruptions were reported in the Ashfell bench and upper bench, with evacuations from the upper bench. On 2026-03-17, damage occurred in Dreth and the Pellan, and service at Corvane mine and the pit was disrupted. On 2026-03-19, 60 households were displaced from Cranmoor, the lower road was restored, and the operator revised its policy.",
              "confidence": "confirmed",
              "tweet_ids": [
                3,
                7,
                21,
                41,
                46,
                55,
                63,
                99,
