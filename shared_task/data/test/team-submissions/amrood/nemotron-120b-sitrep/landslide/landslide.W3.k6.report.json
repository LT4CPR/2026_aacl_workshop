      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide in Dreth damaged the lower road and disrupted services at the Corvane mine and Ashfell bench. Evacuations affected approximately 60 households from Withel terraces and Cranmoor, with community support organized in response. Restoration efforts included repair of the lower road and policy revisions by Yelverton Minerals.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
