      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide in Dreth damaged the lower road and disrupted services at the Corvane mine and Ashfell bench.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Evacuations and displacements affected Withel terraces, Cranmoor, and the upper bench, with about 60 households evacuated from Withel terraces and 60 households displaced from Cranmoor.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Warnings were issued for Withel terraces and Cranmoor, and restoration efforts included the repair of the lower road by Yelverton Minerals.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
