    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide at Ashfell Slide damaged the lower road and disrupted services in Dreth, Withel terraces, Cranmoor, and the Pellan area.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Evacuations affected approximately 60 households from Withel terraces and displaced persons from Cranmoor due to the slide and bench failures.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Response efforts included road restoration, policy revisions by Yelverton Minerals and independent panels, and community support organization in Withel terraces.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
