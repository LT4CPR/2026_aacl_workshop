    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide (Ashfell Slide) in Dreth damaged the lower road and disrupted mine services, prompting evacuations from Withel terraces and Cranmoor. Approximately 60 households were evacuated from Withel terraces, with additional evacuations from Cranmoor and the bench areas. Warnings were issued for Withel terraces and Cranmoor, and service restoration efforts began on the lower road and in Dreth and the Pellan by March 19.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "On March 14, a bench failure damaged the lower road and warnings were issued for Withel terraces and Cranmoor, leading to the evacuation of about 60 households from Withel terraces and people from Cranmoor; by March 16, evacuations expanded to the upper bench and service disruptions were reported in the Ashfell bench; on March 17, service disruptions continued at Corvane mine and the pit, with information provided about the tailings pond and dam; on March 18, further service disruptions were reported at the pit; on March 19, 60 households moved away from Cranmoor due to displacement, the lower road was restored by Yelverton Minerals, and service was restored in Dreth and the Pellan.",
              "confidence": "confirmed",
