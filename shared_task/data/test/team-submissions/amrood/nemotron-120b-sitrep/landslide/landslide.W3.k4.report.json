      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide in Dreth damaged the lower road and disrupted services at the Corvane mine and Ashfell bench.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Evacuations affected approximately 60 households from Withel terraces and Cranmoor, with warnings issued for Withel terraces and Cranmoor.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Response efforts included road restoration, community support organization, and policy revisions by Yelverton Minerals following meetings with the mines inspectorate.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
