    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide in Dreth prompted evacuations of approximately 60 households from Withel terraces and Cranmoor, with damage reported to the lower road and service disruptions at the Corvane mine and Ashfell bench.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Evacuations and displacements were ongoing, with service restoration efforts underway for the lower road and Dreth/Pellan areas by March 19.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Policy revisions by Yelverton Minerals and an independent panel were announced, and community support was organized in the terraces.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
