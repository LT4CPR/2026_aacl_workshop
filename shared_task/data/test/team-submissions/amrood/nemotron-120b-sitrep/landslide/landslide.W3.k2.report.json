    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide in Dreth damaged the lower road and disrupted services at the Corvane mine and Ashfell bench areas. Evacuations affected approximately 60 households from Withel terraces and residents from Cranmoor, with displacement and service disruptions reported throughout the period. Restoration efforts began on March 19, including road and service repairs, alongside policy revisions by Yelverton Minerals and community support initiatives.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "On March 14, the Ashfell slide damaged the lower road and prompted evacuations of about 60 households from Withel terraces and people from Cranmoor; on March 16, service disruptions were reported in Ashfell bench and upper bench areas; on March 17, damage occurred in Dreth and the Pellan, with ongoing mine service disruptions; on March 19, 60 households were displaced from Cranmoor, the lower road was restored, service was restored in Dreth and the Pellan, and assistance was provided in Withel terraces and Cranmoor.",
