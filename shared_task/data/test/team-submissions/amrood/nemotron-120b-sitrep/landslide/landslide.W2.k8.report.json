    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide (Ashfell Slide) occurred near Dreth, triggering evacuations and service disruptions. Approximately 60 households were evacuated from Withel terraces and Cranmoor, with damage reported to the lower road and Corvane mine services. Restoration efforts began on March 19, including road repairs and policy revisions by Yelverton Minerals.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
