      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide in Dreth damaged the lower road and disrupted services at the Corvane mine and Ashfell bench.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Evacuations affected approximately 60 households from Withel terraces and Cranmoor, with displacement later confirmed in Cranmoor.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Warnings were issued for Withel terraces and Cranmoor, and Yelverton Minerals and an independent panel revised operational policies following the slide.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
