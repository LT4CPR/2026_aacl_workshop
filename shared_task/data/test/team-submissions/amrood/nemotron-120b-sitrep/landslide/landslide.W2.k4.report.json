      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide (Ashfell Slide) occurred near Dreth, damaging the lower road and disrupting services at the Corvane mine and upper bench.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Warnings were issued for Withel terraces and Cranmoor, leading to the evacuation of about 60 households from Withel terraces and displacement from Cranmoor.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Response efforts included evacuations, service disruptions, and eventual restoration of the lower road, with ongoing information updates about tailings dams and policy revisions.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
