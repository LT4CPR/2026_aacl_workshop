    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide (Ashfell Slide) damaged the lower road and disrupted services in the Dreth area, including at Corvane mine and Ashfell bench.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Evacuations were carried out from Withel terraces and Cranmoor, with approximately 60 households displaced from Withel terraces and 60 households moved from Cranmoor.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Response efforts included damage assessments, service disruptions reporting, and eventual restoration of the lower road, alongside policy revisions by the operating company.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
