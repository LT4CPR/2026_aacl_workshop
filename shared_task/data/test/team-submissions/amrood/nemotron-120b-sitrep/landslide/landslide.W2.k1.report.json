      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A landslide at the Ashfell slide in Dreth prompted evacuations and service disruptions across Withel terraces, Cranmoor, and Ashfell bench areas.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Approximately 60 households were evacuated from Withel terraces and Cranmoor, with additional evacuations from Ashfell bench.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "The lower road was damaged by the slide but later restored, while service disruptions affected the Corvane mine and bench areas; Yelverton Minerals and an independent panel revised operational policies.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
