    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A mining-region landslide (Ashfell Slide) damaged the lower road in Dreth, triggering evacuations and service disruptions. Approximately 60 households were evacuated from Withel terraces and Cranmoor, with service disruptions reported at the Corvane mine, upper bench, pit, and lower road. Warnings were issued for Withel terraces and Cranmoor, and the lower road has since been restored.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "On 2026-03-14 at 04:55 UTC, the Ashfell slide damaged the lower road; warnings were issued for Withel terraces and Cranmoor starting at 07:21 UTC, followed by evacuation of about 60 households from Withel terraces and Cranmoor beginning at 07:25 UTC; service disruptions occurred at the Corvane mine, upper bench, pit, and lower road from 2026-03-16 onward; the lower road was restored by 2026-03-19 at 12:16 UTC.",
              "confidence": "confirmed",
              "tweet_ids": [
                3,
                7,
                10,
                56,
                75,
                127
              ]
            }
          ]
        }
      ]
