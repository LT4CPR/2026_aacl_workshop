      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "Verlow experienced a heatwave with associated grid strain, leading to hospital service disruptions and substation destruction. The Provincial Public Health Institute issued warnings and deployed assistance, while Grennet Power responded to infrastructure impacts. The heatwave caused deaths and injuries, with dangerous conditions reported at Hetton Rise and Camber Green.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
