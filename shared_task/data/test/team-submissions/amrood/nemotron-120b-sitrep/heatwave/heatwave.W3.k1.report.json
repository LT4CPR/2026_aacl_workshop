      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "Verlow experienced a heatwave causing hospital service disruptions, substation destruction, and confirmed injuries and deaths. Provincial Public Health Institute issued warnings and deployed assistance, while Grennet Power and network operators responded to grid strain. Displacement occurred as people moved away from Verlow, and dangerous conditions developed at Hetton Rise and Camber Green.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
