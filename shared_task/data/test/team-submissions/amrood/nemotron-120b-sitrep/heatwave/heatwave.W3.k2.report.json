    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A heatwave in Verlow has caused widespread disruption, including the destruction of the Marnest substation and service disruptions at Verlow General Hospital, leading to confirmed injuries.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "The Provincial Public Health Institute (PPHI) has issued multiple warnings and deployed assistance, while Grennet Power and the network operator have also deployed resources amid ongoing loadshedding.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Displacement has occurred as people moved away from Verlow due to the heatwave, and the warning period has been linked to deaths reported by government and media sources.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
