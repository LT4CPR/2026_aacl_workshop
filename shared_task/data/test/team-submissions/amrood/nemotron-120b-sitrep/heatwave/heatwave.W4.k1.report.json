    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "Verlow experienced a heatwave with associated grid strain, leading to hospital service disruptions and substation destruction. The Provincial Public Health Institute issued repeated warnings and deployed assistance, while Grennet Power and Verlow Tramways caused infrastructure damage. Displacement occurred as people moved away from Verlow, and the heatwave caused confirmed deaths and injuries.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "On 2026-06-23, the Provincial Public Health Institute issued warnings for Verlow and deployed assistance; on 2026-06-25, service at Verlow General Hospital was disrupted and Grennet Power issued warnings; on 2026-06-26, Marnest substation was destroyed and injuries were confirmed in Verlow; on 2026-06-27, people moved away from Verlow due to displacement and the heatwave caused deaths; on 2026-06-28, the Provincial Public Health Institute issued further warnings; on 2026-07-01, dangerous conditions developed at Hetton Rise and Camber Green, assistance was provided in Hetton Rise and tower blocks, and meetings were held in Verlow.",
              "confidence": "confirmed",
