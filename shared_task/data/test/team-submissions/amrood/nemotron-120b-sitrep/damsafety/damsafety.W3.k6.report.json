          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "Halvern Dam and its right abutment sustained damage, prompting emergency response in the Assek Valley. Authorities ordered a mandatory evacuation of Brindlemark and surrounding areas, displacing approximately 12,400 residents. The alert level was raised from Yellow to Orange as precautionary measures were implemented to avert dam failure.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
