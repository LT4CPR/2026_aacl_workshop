          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "Halvern Dam and its right abutment sustained damage, prompting emergency response in Brindlemark and surrounding areas of the Assek Valley.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "A mandatory evacuation was ordered, moving approximately 11,800 to 12,400 residents from Brindlemark, Ferris Hollow, and Quennard, with the alert level raised from Yellow to Orange.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Authorities deployed police and provided assistance in affected communities, including Quennard, amid ongoing safety operations.",
