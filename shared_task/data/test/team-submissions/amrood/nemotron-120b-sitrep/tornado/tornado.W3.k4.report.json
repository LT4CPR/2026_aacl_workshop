      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A multi-site tornado outbreak impacted Estenwick, Dray Corners, Palfrey, and Ostley County from May 19 to May 23, 2026, resulting in 9 fatalities and 38 injuries.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Evacuations displaced approximately 240 people from Millrow district and Ostley County, with widespread infrastructure damage including destruction of Route 12, grain elevator, school, and gymnasium.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Emergency response involved police deployment, coroner investigations, and restoration of critical routes by May 23, amid ongoing dangerous conditions.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
