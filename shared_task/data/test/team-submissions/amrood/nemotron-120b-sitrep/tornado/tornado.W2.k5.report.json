          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A multi-site tornado outbreak affected Estenwick, Dray Corners, and Ostley County, with multiple tornado warnings issued throughout the afternoon and evening.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Evacuations were conducted from Estenwick and Dray Corners Dray Corners, and significant infrastructure damage occurred, including destruction of Route 12 and the grain elevator in Dray Corners, as well as damage in the Millrow district and Palfrey.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Casualties were reported with deaths occurring in the Millrow district, while possible rescues were noted in the same area, and police were deployed to support response efforts.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
