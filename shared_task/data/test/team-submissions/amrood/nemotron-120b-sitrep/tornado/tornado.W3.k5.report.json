    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A multi-site tornado outbreak affected Estenwick, Dray Corners, and Ostley County, resulting in 9 fatalities, 38 injuries, and widespread destruction including Route 12, grain elevator, and Estenwick Consolidated School.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Evacuations displaced approximately 240 people from Millrow district and Ostley County, with emergency services conducting rescue operations and damage assessments ongoing.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Restoration efforts began with Route 12 and grain elevator restored, while dangerous conditions persisted in affected areas through May 23.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
