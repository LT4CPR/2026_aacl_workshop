      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A multi-site tornado outbreak impacted Estenwick, Dray Corners, and Ostley County, resulting in 9 fatalities and 38 injuries.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Evacuations displaced approximately 240 people from Millrow district and Ostley County, with Route 12 and key infrastructure destroyed.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Emergency response included police deployment, coroner investigations, and requests for provincial emergency management assistance.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
