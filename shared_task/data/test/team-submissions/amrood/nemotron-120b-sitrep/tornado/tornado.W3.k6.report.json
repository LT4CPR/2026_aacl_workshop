        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A multi-site tornado outbreak impacted Estenwick, Dray Corners, and Ostley County from May 19 to May 23, 2026, resulting in 9 fatalities and 38 injuries.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Warnings were issued for Estenwick, Dray Corners, and Ostley County, prompting evacuations and displacement of approximately 240 people from Millrow district and Ostley County.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Infrastructure damage included destruction of Route 12 and grain elevator in Dray Corners, damage in Millrow district and Palfrey, and destruction of Estenwick Consolidated School and its gymnasium; Route 12 and grain elevator were later restored.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
