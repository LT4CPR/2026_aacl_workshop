      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A multi-site tornado outbreak impacted Estenwick and Ostley County, resulting in 9 fatalities and 38 injuries. Widespread destruction occurred, including Route 12, grain elevators, and the Estenwick Consolidated School gymnasium. Approximately 240 people were displaced from Millrow district and Ostley County, with ongoing evacuations and Route 12 closures reported.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
