      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A multi-site tornado outbreak affected Estenwick, Dray Corners, and Ostley County from May 19 to May 23, 2026, resulting in 9 fatalities and 38 injuries.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Evacuations displaced approximately 240 people from Millrow district and Ostley County, with dangerous conditions persisting across multiple locations.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Infrastructure damage included destruction of Route 12, grain elevator, Estenwick Consolidated School, and its gymnasium, while restoration efforts began on May 23.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
