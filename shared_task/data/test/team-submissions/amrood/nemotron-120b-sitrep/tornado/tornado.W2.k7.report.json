      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A multi-site tornado outbreak affected Estenwick, Dray Corners, and Ostley County, with warnings issued across the region. Evacuations were conducted from Estenwick and Dray Corners, and significant damage occurred in Millrow district, Palfrey, and the farm belt, including destruction of Route 12 and the grain elevator in Dray Corners. Three fatalities were confirmed in Millrow district, and rescue operations were reported in the area.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
