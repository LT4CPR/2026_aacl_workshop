      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "Warnings were issued for Estenwick and Dray Corners beginning at 15:38 UTC, with evacuations from Estenwick and Dray Corners reported starting at 19:00 UTC; Route 12 and the grain elevator in Dray Corners were destroyed by 20:24 UTC, and 3 fatalities in Millrow district were confirmed at 21:54 UTC.",
