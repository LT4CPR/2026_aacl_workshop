          "bullets": [
            {
              "id": "1a.1",
              "text": "A multi-site tornado outbreak affected Estenwick and Ostley County, with multiple warnings issued for Estenwick, Dray Corners, and Ostley County between 15:38 and 19:00 UTC on 2026-05-19.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Evacuations were conducted from Estenwick and Dray Corners starting at 19:00 UTC, with people moved out of the towns as part of emergency response.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Significant infrastructure damage occurred, including destruction of Route 12 and the grain elevator in Dray Corners, and 3 fatalities were confirmed in the Millrow district by 22:07 UTC.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
