  "sections": [
    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A multi-site tornado outbreak impacted Estenwick and Ostley County, resulting in 9 confirmed fatalities and injuries documented in Estenwick. Widespread destruction occurred, including Route 12, grain elevator, gymnasium, and Estenwick Consolidated School, with evacuations displacing about 240 people from Millrow district and Ostley County. Response efforts included police deployment, coroner information provision, and restoration of Route 12 and grain elevator by May 23.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "Warnings were issued for Estenwick, Dray Corners, and Ostley County on May 19 starting at 15:43 UTC, with evacuations beginning by 19:04 UTC; destruction of Route 12 and grain elevator was confirmed by 20:26 UTC, and 3 fatalities in Millrow district were reported by 21:50 UTC; by May 20, 9 deaths were confirmed in Ostley County, and by May 23, Route 12 and grain elevator were restored.",
              "confidence": "confirmed",
              "tweet_ids": [
                3,
