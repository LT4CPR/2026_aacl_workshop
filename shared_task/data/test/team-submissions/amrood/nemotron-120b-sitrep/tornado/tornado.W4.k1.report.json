    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A multi-site tornado outbreak impacted Estenwick, Dray Corners, and Ostley County from May 19 to May 24, 2026, resulting in 9 fatalities and 38 injuries.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Significant infrastructure damage occurred, including destruction of Route 12 and grain elevators in Dray Corners, the gymnasium at Estenwick Consolidated School, and damage in Millrow district, Palfrey, and the farm belt.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Emergency response included evacuations of approximately 240 people from Millrow district and Ostley County, deployment of Estenwick Police, and coordination between Provincial Severe Weather Centre and Ostley County Emergency Management.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
