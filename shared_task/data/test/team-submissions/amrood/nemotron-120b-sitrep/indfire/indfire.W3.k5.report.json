  "sections": [
    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "An industrial fire at the Kellet Point industrial estate in Osmery prompted warnings for Brayle and Sunder Flats, road closures, and service disruptions. A mandatory evacuation moved approximately 2,300 residents from Brayle, with additional evacuations from Osmery and displacement of about 300 people from Osmery. Injuries were documented in Osmery, no deaths were reported, and no contamination was recorded in Merrin Canal, with Provincial Environmental Protection Agency and Fallon Coatings deploying in response.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "On December 2, 2025, warnings were issued for Brayle and Sunder Flats, Kellet Road was closed in Kellet Point industrial estate and Merrin Canal, and a mandatory evacuation was ordered for Brayle, moving about 2,300 residents; on December 3, injuries were documented in Osmery and service disruptions occurred in Kellet Point industrial estate and Merrin Canal; on December 4, no contamination was recorded in Merrin Canal and damage occurred in Brayle; on December 5, services were restored in Brayle and no deaths were reported.",
              "confidence": "confirmed",
              "tweet_ids": [
                8,
                10,
                18,
                56,
                64,
                127,
                139,
                164,
                180,
                205,
