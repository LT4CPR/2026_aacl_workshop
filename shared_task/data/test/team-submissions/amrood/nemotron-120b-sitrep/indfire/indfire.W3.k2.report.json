          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "An industrial fire at the Kellet Point industrial estate in Osmery prompted warnings and evacuations starting December 2, 2025.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "A mandatory evacuation moved approximately 2,300 residents from Brayle, with about 300 people displaced from Osmery.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Road closures affected Kellet Road in the industrial estate and Merrin Canal, and service disruptions were reported in the area, with no deaths reported in connection with the fire.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
