          "bullets": [
            {
              "id": "1a.1",
              "text": "An industrial fire at Kellet Point in Osmery prompted warnings for the deployment of Fallon Coatings and road closures on Kellet Road and Merrin Canal.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "A mandatory evacuation was ordered for Brayle, resulting in approximately 2,300 residents being evacuated from Brayle and additional evacuations from Osmery.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "Warnings were issued for Brayle, Sunder Flats, and Osmery, with ongoing displacement reported in both areas.",
