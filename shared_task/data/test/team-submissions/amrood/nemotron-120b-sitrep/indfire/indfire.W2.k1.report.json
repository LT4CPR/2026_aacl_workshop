    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "An industrial fire at Kellet Point in Osmery prompted warnings for Brayle and Sunder Flats, and road closures on Kellet Road in the industrial estate and Merrin Canal. Fallon Coatings deployed personnel to the site. A mandatory evacuation was ordered for Brayle, resulting in approximately 2,300 residents being evacuated from Brayle and additional evacuations from Osmery.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "At 10:58, Fallon Coatings deployed; at 11:11, a warning was issued for Brayle; at 11:12, warnings expanded to include Sunder Flats; at 11:16, Kellet Road was closed in Kellet Point industrial estate and Merrin Canal; at 15:22, a mandatory evacuation was ordered for Brayle; by 15:23, about 2,300 residents were evacuated from Brayle; at 19:45, media reported evacuations from both Brayle and Osmery; at 20:10, government confirmed about 2,300 residents evacuated from Brayle.",
              "confidence": "confirmed",
