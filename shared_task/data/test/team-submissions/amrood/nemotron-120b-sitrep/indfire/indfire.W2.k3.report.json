    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "An industrial fire at Kellet Point in Osmery prompted warnings for Brayle and Sunder Flats, road closures on Kellet Road, and a mandatory evacuation of approximately 2,300 residents from Brayle. Additional evacuations occurred from Osmery, displacing around 300 people. No casualties or injuries were reported in the tweets.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Fallon Coatings deployed personnel to the scene, and authorities issued repeated warnings and updates regarding the fire, evacuations, and road closures throughout the reporting period.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "By the end of the window, evacuation efforts continued, with some reports indicating 48 residents evacuated from Brayle, while others maintained the figure of about 2,300, reflecting ongoing or phased evacuation status.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
