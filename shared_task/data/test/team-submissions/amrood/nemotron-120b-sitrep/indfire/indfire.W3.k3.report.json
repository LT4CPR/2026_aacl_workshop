  "sections": [
    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "A warehouse fire at Kellet Point industrial estate in Osmery prompted warnings for Brayle and Sunder Flats, road closures on Kellet Road and Merrin Canal, and evacuations affecting approximately 2,300 residents from Brayle and additional evacuations from Osmery. Injuries were documented and confirmed in Osmery, with no deaths reported. Service disruptions occurred in the industrial estate, followed by restoration in Brayle, while Provincial Environmental Protection Agency deployed and community support was organized.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "On December 2, 2025, at 10:58 UTC, Fallon Coatings deployed; warnings were issued for Brayle and Sunder Flats starting at 11:12 UTC; Kellet Road was closed in Kellet Point industrial estate and Merrin Canal at 11:16 UTC; a mandatory evacuation was ordered for Brayle at 15:27 UTC, moving about 2,300 residents; injuries were documented in Osmery on December 3 starting at 12:48 UTC; service disruption in Kellet Point industrial estate was reported at 18:15 UTC on December 3; service was restored in Brayle on December 5 at 00:53 UTC.",
              "confidence": "confirmed",
              "tweet_ids": [
                3,
                7,
                11,
                55,
                107,
                133,
                176
