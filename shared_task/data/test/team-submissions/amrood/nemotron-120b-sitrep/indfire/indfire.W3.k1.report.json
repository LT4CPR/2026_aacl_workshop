  "sections": [
    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "An industrial fire at the Kellet Point warehouse in Osmery prompted warnings and evacuations affecting Brayle and surrounding areas.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.2",
              "text": "Approximately 2,300 residents were evacuated from Brayle and about 300 people were displaced from Osmery, with road closures on Kellet Road and service disruptions in the industrial estate and Merrin Canal.",
              "confidence": "confirmed",
              "tweet_ids": []
            },
            {
              "id": "1a.3",
              "text": "No deaths were reported, injuries were documented in Osmery, and the Provincial Environmental Protection Agency deployed to assist with response and information provision.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "On December 2, 2025, warnings were issued for Brayle and Sunder Flats starting at 10:58 UTC, followed by Kellet Road closures in the industrial estate and Merrin Canal from 11:14 UTC, and a mandatory evacuation of Brayle ordered at 15:23 UTC affecting about 2,300 residents.",
              "confidence": "confirmed",
              "tweet_ids": [
                3,
                7,
                13,
                56,
                60,
                70
              ]
            }
          ]
        }
      ]
