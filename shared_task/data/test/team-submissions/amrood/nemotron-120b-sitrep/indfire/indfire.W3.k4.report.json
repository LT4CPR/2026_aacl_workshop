  "sections": [
    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "An industrial fire at the Kellet Point industrial estate in Osmery prompted warnings for Brayle and Sunder Flats, road closures, and a mandatory evacuation of approximately 2,300 residents from Brayle and additional evacuations from Osmery. Injuries were documented in the town, with service disruptions reported in the Kellet Point industrial estate and Merrin Canal, though no contamination was recorded in the canal and no deaths were reported. Response efforts included deployment of Fallon Coatings, the operator, and the Provincial Environmental Protection Agency, with community support organized in Brayle and assistance received in the area.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "On December 2, 2025, at 10:58 UTC, Fallon Coatings deployed; warnings were issued for Brayle and Sunder Flats; Kellet Road was closed in the Kellet Point industrial estate and Merrin Canal; a mandatory evacuation was ordered for Brayle, moving about 2,300 residents, with additional evacuations from Osmery. On December 3, injuries were documented and confirmed in Osmery, service disruptions occurred in the Kellet Point industrial estate and Merrin Canal, and a warning was issued for Merrin Canal. On December 4, no contamination was recorded in Merrin Canal, damage occurred in Brayle, and Sunder Flats was confirmed not subject to evacuation. On December 5, services were closed in Brayle, service was restored in Brayle, no deaths were reported, assistance was received and requested, and community support was organized in Brayle.",
              "confidence": "confirmed",
