      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "An industrial fire at Kellet Point in Osmery prompted warnings for Brayle and Sunder Flats, road closures on Kellet Road, and a mandatory evacuation of approximately 2,300 residents from Brayle. Fallon Coatings deployed resources to the incident. Displacement was also reported from Osmery, with about 300 people displaced from the town.",
              "confidence": "confirmed",
              "tweet_ids": []
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "A warning was issued for Brayle and Sunder Flats at 11:12 UTC, followed by Kellet Road closures in Kellet Point industrial estate and Merrin Canal starting at 11:16 UTC. A mandatory evacuation was ordered for Brayle at 15:22 UTC, moving about 2,300 residents. By 20:09 UTC, about 300 people were displaced from Osmery.",
