  "sections": [
    {
      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "An acute watery diarrhoea cluster associated with the Ondaraya outbreak was reported in Kelvaig.",
              "tweet_ids": [
                "2",
                "3",
                "27"
              ],
              "confidence": "confirmed"
            },
            {
              "id": "1a.2",
              "text": "Emergency operations, police activity, and deployments were reported across Ondaraya and at the Delta.",
              "tweet_ids": [
                "7",
                "8",
                "9",
                "10",
                "13"
              ],
              "confidence": "confirmed"
            },
            {
              "id": "1a.3",
              "text": "Reports repeatedly cited 34 suspected cases and described injuries as confirmed in Ondaraya and at the Delta.",
              "tweet_ids": [
                "33",
                "34",
                "35",
                "36",
                "37",
                "39",
                "40",
                "43",
                "44",
                "45"
              ],
              "confidence": "potential"
            },
            {
              "id": "1a.4",
              "text": "Kelvaig experienced an oral rehydration salt shortage before reports confirmed that emergency assistance had reached residents.",
              "tweet_ids": [
                "23",
                "24",
                "25",
                "26",
                "28"
              ],
              "confidence": "confirmed"
            }
          ]
        }
      ]
    },
    {
      "id": "2",
      "title": "Timeline",
      "subsections": [
        {
          "id": "2a",
          "title": "Chronological timeline",
          "bullets": [
            {
              "id": "2a.1",
              "text": "Early in the undated reporting stream, residents described widespread sickness and an acute watery diarrhoea cluster in Kelvaig.",
              "tweet_ids": [
                "2",
                "3"
              ],
              "confidence": "confirmed",
              "time": "Tweet-order phase 1; event time unknown"
            },
            {
              "id": "2a.2",
              "text": "Officials then confirmed a situation update at Serriport and advised people to avoid the area.",
              "tweet_ids": [
                "4",
                "5",
                "12"
              ],
              "confidence": "confirmed",
              "time": "Tweet-order phase 2; event time unknown"
            },
            {
              "id": "2a.3",
              "text": "Police activity, deployments, and a broader emergency response were subsequently reported at the Delta and across Ondaraya.",
              "tweet_ids": [
                "7",
                "8",
                "9",
                "10",
                "13"
              ],
              "confidence": "confirmed",
              "time": "Tweet-order phase 3; event time unknown"
            },
            {
              "id": "2a.4",
              "text": "Later reports stated that Kelvaig's local clinic had exhausted its supply of oral rehydration salts.",
              "tweet_ids": [
                "23",
                "28"
              ],
              "confidence": "confirmed",
              "time": "Tweet-order phase 4; event time unknown"
            },
            {
              "id": "2a.5",
              "text": "Emergency assistance was then reported as delivered to and received by Kelvaig village.",
              "tweet_ids": [
                "24",
                "25",
                "26"
              ],
              "confidence": "confirmed",
              "time": "Tweet-order phase 5; event time unknown"
            },
            {
              "id": "2a.6",
              "text": "The later reporting stream repeatedly cited 34 suspected cases, confirmed injuries, and continuing monitoring in Ondaraya.",
              "tweet_ids": [
                "33",
                "34",
                "35",
                "36",
                "37",
                "39",
                "40",
                "43",
                "44",
                "45"
              ],
              "confidence": "potential",
              "time": "Tweet-order phase 6; event time unknown"
            }
          ]
        }
      ]
    },
