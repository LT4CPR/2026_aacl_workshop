          "id": "15a",
          "title": "Source credibility",
          "bullets": [
            {
              "id": "15a.1",
              "text": "Ten signal tweets explicitly attribute information to officials or Karvale Front representatives.",
              "tweet_ids": ["2", "3", "4", "7", "8", "9", "18", "20", "21", "22"],
              "confidence": "background"
            },
            {
              "id": "15a.2",
              "text": "Eight signal tweets are retweets, increasing the distance between the reported event and the visible poster.",
              "tweet_ids": ["7", "8", "11", "12", "13", "15", "17", "19"],
              "confidence": "background"
            },
            {
              "id": "15a.3",
              "text": "Two posts use first-person team reporting without identifying the teams or providing corroborating details.",
              "tweet_ids": ["5", "13"],
              "confidence": "background"
            },
            {
              "id": "15a.4",
              "text": "One direct post appears to describe firsthand exposure to repeated air-raid sirens.",
