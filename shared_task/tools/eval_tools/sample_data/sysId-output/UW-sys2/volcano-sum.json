      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "An eruption at Mount Vurren is accompanied by confirmed earthquake and tremor activity that has continued for more than 24 hours.",
              "tweet_ids": [
                "5",
                "7",
                "12",
                "24"
              ],
              "confidence": "confirmed"
            },
            {
              "id": "1a.2",
              "text": "The Sarnat Volcano Observatory has reported dangerous conditions around the mountain, with repeated advice to avoid the area.",
              "tweet_ids": [
                "2",
                "3",
                "8",
                "18",
                "23",
                "25",
                "27"
              ],
              "confidence": "confirmed"
            },
            {
              "id": "1a.3",
              "text": "Response activity includes monitoring, an observatory response, and confirmed deployments associated with Mount Vurren.",
              "tweet_ids": [
                "9",
                "14",
                "22",
                "33"
              ],
              "confidence": "confirmed"
            }
          ]
        }
      ]
    },
