      "id": "1",
      "title": "Situation overview",
      "subsections": [
        {
          "id": "1a",
          "title": "Overview",
          "bullets": [
            {
              "id": "1a.1",
              "text": "An acute watery diarrhoea outbreak is affecting residents around Kelvaig and the wider Ondaraya area.",
              "tweet_ids": [
                "2",
                "3",
                "27"
              ],
              "confidence": "confirmed"
            },
            {
              "id": "1a.2",
              "text": "Reports repeatedly cite a cumulative total of 34 suspected cases.",
              "tweet_ids": [
                "33",
                "34",
                "36",
                "39",
                "40",
                "43",
                "45"
              ],
              "confidence": "potential"
            },
            {
              "id": "1a.3",
              "text": "Officials and alert accounts report confirmed injuries in Ondaraya and the delta area.",
              "tweet_ids": [
                "34",
                "35",
                "36",
                "39",
                "43",
                "45"
              ],
              "confidence": "confirmed"
            },
            {
              "id": "1a.4",
              "text": "The response includes police activity, emergency deployments, aid delivery, and public instructions to avoid affected areas.",
              "tweet_ids": [
                "7",
                "8",
                "9",
                "13",
                "24",
                "25",
                "26"
              ],
              "confidence": "confirmed"
            }
